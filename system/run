        const payout = largest2(payouts);
        const deposit = largest2(open.filter((tx) => tx.direction === "in"));
        suspicions.push({
          code: code2,
          rank: rankOf(code2),
          evidence: [...deposit ? [deposit.transaction_id] : [], payout.transaction_id],
          fact: `${deposit ? `${describe(deposit)} came from a third party and ` : ""}${describe(payout)} was paid out to someone other than ${label4(customer.name)}${code2 === "ESC_EARLY_REDEMPTION" ? " after fund units were bought and quickly sold" : ""}, with no relationship documented`
        });
        continue;
      }
    }
    gaps.push(gapFor(pack, alert, open, index));
  }
  let heldSupport;
  if (caseRecord.institution === "payments_fx" && heldPayment) {
    const support = index.byTx.get(heldPayment.transaction_id);
    const large = heldPayment.amount_gbp >= 1e4;
    const owned = support?.code === "OWN_ACCOUNT" && support.docs.length > 0;
    const evidencedPurpose = support?.code === "INVOICE_MATCHES" && documents.some((doc) => RELEASE_DOCUMENT_TYPES.has(doc.metadata.type) && support.docs.includes(doc.metadata.doc_id));
    if (support && (!large || owned || evidencedPurpose)) {
      heldSupport = { tx: heldPayment, explanation: support };
    } else {
