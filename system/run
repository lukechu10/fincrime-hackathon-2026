var taskKey = (task) => `${task.kind}:${task.doc.metadata.doc_id}`;
function planTasks(pack, decision) {
  if (decision.verdict === "ESCALATE") return [];
  const { from, to } = pack.caseRecord.review_window;
  const latest = pack.heldPayment && pack.heldPayment.booked_at.slice(0, 10) > to ? pack.heldPayment.booked_at.slice(0, 10) : to;
  const own = pack.documents.filter((doc) => doc.metadata.customer_id === pack.customer.customer_id);
  const tasks = [];
  if (decision.verdict === "RFI") {
    const used = /* @__PURE__ */ new Set([...decision.evidence, ...[...explainTransactions(pack).byTx.values()].flatMap((e) => e.docs)]);
    tasks.push(...own.filter((doc) => !NOT_PAYMENT_EVIDENCE.has(doc.metadata.type) && !used.has(doc.metadata.doc_id) && doc.metadata.dated <= latest).slice(0, MAX_PAYMENT_DOCS).map((doc) => ({ kind: "payments", doc })));
  }
  tasks.push(...own.filter((doc) => CONCERN_TYPES.has(doc.metadata.type) && doc.metadata.dated >= from).slice(0, MAX_CONCERN_DOCS).map((doc) => ({ kind: "concerns", doc })));
  return tasks;
}
var isString = (v) => typeof v === "string";
var isNullableString = (v) => v === null || typeof v === "string";
var record3 = (v) => v && typeof v === "object" && !Array.isArray(v) ? v : void 0;
function asPaymentFacts(answer) {
  const root = record3(answer);
  if (!root || !Array.isArray(root.payments) || !Array.isArray(root.ownership)) return;
  const payments = root.payments.flatMap((item) => {
    const p = record3(item);
    if (!p || !["to_customer", "from_customer"].includes(p.direction) || !PAYMENT_PURPOSES.includes(p.purpose) || !["confirmed", "scheduled", "conditional", "denied", "partial", "unclear"].includes(p.status)) return [];
    const strings = [p.counterparty, p.counterparty_quote, p.amount, p.amount_quote].every(isString);
    const optional = [p.reference, p.reference_quote, p.due_date, p.due_date_quote, p.recipient, p.recipient_quote].every(isNullableString);
    return strings && optional ? [p] : [];
  });
  const ownership = root.ownership.flatMap((item) => {
    const o = record3(item);
    return o && [o.parent, o.subsidiary, o.quote].every(isString) ? [o] : [];
  });
  return { payments, ownership };
}
function asConcernFacts(answer) {
  const root = record3(answer);
  if (!root) return;
  const statement2 = (v) => {
    const s = record3(v);
    return s && s.present === true && isString(s.quote) ? { present: true, quote: s.quote } : { present: false, quote: null };
  };
  return {
    structuring: statement2(root.structuring),
    account_used_by_others: statement2(root.account_used_by_others),
    refused_to_explain: statement2(root.refused_to_explain)
  };
}
function findingsFor(pack, tasks, answers) {
  const explanations = [];
  const signals = [];
  for (const task of tasks) {
    const answer = answers.get(taskKey(task));
    if (task.kind === "payments") {
      const facts = asPaymentFacts(answer);
      if (facts) explanations.push(...explainFromDocument(pack, task.doc, facts));
    } else {
      const facts = asConcernFacts(answer);
      if (facts) signals.push(...signalsFromDocument(pack, task.doc, facts));
    }
  }
  return { explanations, signals };
}
async function readAll(tasks, reader, concurrency = 8) {
  const answers = /* @__PURE__ */ new Map();
  const distinct2 = [...new Map(tasks.map((t) => [taskKey(t.task), t])).values()];
  let next = 0;
  async function worker() {
    while (next < distinct2.length) {
      const { task, customerName } = distinct2[next++];
      answers.set(taskKey(task), await reader.read(task.kind, task.doc, customerName));
    }
  }
  await Promise.all(Array.from({ length: Math.min(concurrency, distinct2.length) }, worker));
  return answers;
}

