      const ownName = sameName(heldPayment.counterparty_name, customer.name);
      gaps.push({
        code: "RFI_PURPOSE_DOCUMENTS",
        rank: GAP_ORDER.indexOf("RELEASE"),
        evidence: [heldPayment.transaction_id],
        fact: `The held payment of ${describe(heldPayment)} ${ownName ? "names the client but the destination account has not been shown to belong to them" : large ? "is \xA310,000 or more and no invoice or contract on file supports it" : "is not explained by the evidence on file"}`,
