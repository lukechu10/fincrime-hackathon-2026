function collectionReports(ctx, add) {
  const branches = /* @__PURE__ */ new Map();
  const procedures = ofType(ctx, "cash_handling_procedure");
  for (const doc of procedures) {
    for (const m of doc.markdown.matchAll(/^(.+? car park):.*?\bat (.+? branch)\b/gim)) branches.set(norm(m[1]), norm(m[2]));
  }
  for (const doc of ofType(ctx, "cash_collection_reports")) {
    const rows = tableRows(doc.markdown, ["site", "emptied", "notes", "coins", "total", "safe bag"]);
    if (new Set(rows.map((row) => row["safe bag"])).size !== rows.length) continue;
    const used = /* @__PURE__ */ new Set();
    for (const tx of incoming(ctx).filter(isCash)) {
      const index = rows.findIndex((row2, i) => {
        const emptied = isoDay(row2.emptied);
        const total = pounds(row2.total);
        const branch = branches.get(norm(row2.site));
        return !used.has(i) && !!emptied && typeof tx.reference === "string" && norm(tx.reference) === `${norm(row2.site)} takings` && samePence(tx, total) && (pounds(row2.notes) ?? 0) + (pounds(row2.coins) ?? 0) === total && daysBetween(emptied, txDay(tx)) >= 1 && daysBetween(emptied, txDay(tx)) <= 3 && (!branch || typeof tx.location === "string" && norm(tx.location) === branch);
      });
      if (index < 0) continue;
      used.add(index);
      const row = rows[index];
      add(tx, {
        code: "BUSINESS_RECORDS_RECONCILE",
        docs: [doc.metadata.doc_id, ...procedures.map((d) => d.metadata.doc_id)],
        related: [],
        fact: `${doc.metadata.doc_id} records ${row.site} emptied on ${row.emptied} with ${row.total} counted into safe bag ${row["safe bag"]}, banked as ${describe(tx)}`
      });
    }
  }
}
