// src/evidence-extraction.ts
var invoiceFields = {
  "bill to": "billedTo",
  buyer: "buyer",
  customer: "customer",
  patient: "patient",
  supplier: "supplier",
  carrier: "carrier",
  description: "description",
  goods: "goods",
  service: "service",
  treatment: "treatment",
  vehicle: "vehicle",
  terms: "terms"
};
var statementFields = {
  "account holder": "accountHolder",
  "account holders": "accountHolders",
  "account name": "accountName",
  bank: "bank",
  account: "account"
};
var companyFields = {
  company: "company",
  "company number": "companyNumber",
  "registered office": "registeredOffice",
  "nature of business": "natureOfBusiness",
  status: "companyStatus"
};
var invoiceAmounts = {
  "amount due": "amountDue",
  amount: "amount",
  total: "total",
  price: "price",
  "paid by bank transfer": "amountPaidByTransfer"
};
var invoiceTypes = /* @__PURE__ */ new Set([
  "invoice",
  "dealer_invoice",
  "hospital_invoice",
  "supplier_invoice",
  "supplier_invoices",
  "carrier_invoice",
  "freight_invoices"
]);
var registerTypes = /* @__PURE__ */ new Set(["company_register_extract", "significant_control_register"]);
var months = "January February March April May June July August September October November December".split(" ");
var gbpNumber = String.raw`(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d{2})?`;
function parseGbp(text2) {
  const match = new RegExp(`^\xA3\\s*(${gbpNumber})$`).exec(text2);
  if (!match) return;
  const [pounds2, pence2 = "00"] = match[1].replaceAll(",", "").split(".");
  const minorUnits = Number(pounds2 + pence2);
  if (Number.isSafeInteger(minorUnits)) return { currency: "GBP", minorUnits };
}
function parseDate(text2) {
  const named = /^(\d{1,2}) ([A-Za-z]+) (\d{4})$/.exec(text2);
  let normalized = text2;
  if (named) {
    const [, day, name, year] = named;
    const month = months.findIndex((m) => m.toLowerCase() === name.toLowerCase()) + 1;
    if (!month) return;
    normalized = `${year}-${String(month).padStart(2, "0")}-${day.padStart(2, "0")}`;
  } else if (!/^\d{4}-\d{2}-\d{2}$/.test(text2)) {
    return;
  }
  const date = /* @__PURE__ */ new Date(`${normalized}T00:00:00Z`);
  if (Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === normalized) return normalized;
}
function textFact(out, field3, value, source) {
  if (value && value !== "\u2014" && value !== "-") out.push({ field: field3, value, source });
}
function dateFact(out, field3, value, source) {
  textFact(out, field3, value && parseDate(value), source);
}
function amountFact(out, field3, value, source) {
  const normalized = value && parseGbp(value);
  if (normalized) out.push({ field: field3, value: normalized, source });
}
function lookup(map, key) {
  return Object.hasOwn(map, key) ? map[key] : void 0;
}
function tableEntry(kind, cells, headers, source) {
  if (cells.length !== headers.length) return;
  const get = (label5) => cells[headers.indexOf(label5)];
  const facts = [];
  if (kind === "invoice" && headers.includes("invoice") && headers.includes("amount")) {
    textFact(facts, "invoiceNumber", get("invoice"), source);
    dateFact(facts, "invoiceDate", get("dated"), source);
    textFact(facts, "goods", get("goods"), source);
    textFact(facts, "exporter", get("exporter"), source);
    amountFact(facts, "amount", get("amount"), source);
    return { kind: "invoiceLine", facts };
  }
  if (kind !== "companyRegister") return;
  const isOfficer = headers.includes("officer") && headers.includes("role");
  const isControl = headers.includes("control") && (headers.includes("person") || headers.includes("person with significant control"));
  if (!isOfficer && !isControl) return;
  textFact(facts, "person", get("officer") ?? get("person with significant control") ?? get("person"), source);
  textFact(facts, "role", get("role"), source);
  textFact(facts, "birthDetail", get("born"), source);
  textFact(facts, "control", get("control"), source);
  dateFact(facts, "appointedDate", get("appointed"), source);
  dateFact(facts, "resignedDate", get("resigned"), source);
  dateFact(facts, "notifiedDate", get("notified"), source);
  dateFact(facts, "ceasedDate", get("ceased"), source);
  return { kind: isOfficer ? "companyOfficer" : "significantControl", facts };
}
function invoicePayTo(facts, value, source) {
  const account = /^(.*?),\s*(account\s+.+|IBAN\s+.+)$/i.exec(value);
  if (account) {
    textFact(facts, "payee", account[1], source);
    textFact(facts, "paymentDestination", account[2], source);
  } else if (/^(IBAN|account)\b/i.test(value)) {
    textFact(facts, "paymentDestination", value, source);
  } else {
    textFact(facts, "payee", value, source);
  }
}
function extractEvidence(docId, type, markdown) {
  const kind = invoiceTypes.has(type) ? "invoice" : type === "bank_statement" ? "bankStatement" : registerTypes.has(type) ? "companyRegister" : "unparsed";
  const facts = [];
  const entries = [];
  if (kind === "unparsed") return { kind, facts, entries };
  const movementAmount = new RegExp(`^(?:transfer of\\s+|received\\s+)?(\xA3\\s*${gbpNumber})(?=\\s|$)`, "i");
  let headers;
  const lines = markdown.split(/\r?\n/);
  for (const [i, excerpt] of lines.entries()) {
    const line = excerpt.trim();
    const source = { docId, line: i + 1, excerpt };
    if (line.startsWith("|") && line.endsWith("|")) {
      const cells = line.slice(1, -1).split(/(?<!\\)\|/).map((cell) => cell.trim().replaceAll("\\|", "|"));
      const separator = lines[i + 1]?.trim();
      if (separator && /^\|(?:\s*:?-{3,}:?\s*\|)+$/.test(separator)) {
        headers = cells.map((cell) => cell.toLowerCase());
      } else if (headers && !/^\|(?:\s*:?-{3,}:?\s*\|)+$/.test(line)) {
        const entry = tableEntry(kind, cells, headers, source);
        if (entry?.facts.length) entries.push(entry);
      }
      continue;
    }
    headers = void 0;
    const heading = /^#\s+(.+)$/.exec(line);
    if (heading) textFact(facts, "title", heading[1], source);
    const field3 = /^\*\*([^*]+):\*\*\s*(.+)$/.exec(line);
    if (field3) {
      const label5 = field3[1].toLowerCase();
      const value = field3[2];
      if (label5 === "dated") dateFact(facts, "documentDate", value, source);
      if (kind === "invoice") {
        const textKey = lookup(invoiceFields, label5);
        const amountKey = lookup(invoiceAmounts, label5);
        if (textKey) textFact(facts, textKey, value, source);
        if (amountKey) amountFact(facts, amountKey, value, source);
        if (label5 === "pay to") invoicePayTo(facts, value, source);
      } else if (kind === "bankStatement") {
        const key = lookup(statementFields, label5);
        if (key) textFact(facts, key, value, source);
      } else {
        const key = lookup(companyFields, label5);
        if (key) textFact(facts, key, value, source);
        if (label5 === "incorporated") dateFact(facts, "incorporationDate", value, source);
        if (label5 === "status" && /^dissolved on /i.test(value)) {
          dateFact(facts, "dissolutionDate", value.slice("dissolved on ".length), source);
        }
      }
    } else if (kind === "bankStatement") {
      const movement = /^([^:]+):\s+(.+)$/.exec(line);
      if (!movement) continue;
      const date = parseDate(movement[1]);
      const amount = movementAmount.exec(movement[2]);
      if (!date || !amount) continue;
      const movementFacts = [];
      textFact(movementFacts, "movementDate", date, source);
      amountFact(movementFacts, "amount", amount[1], source);
      textFact(movementFacts, "movementDetails", movement[2], source);
      entries.push({ kind: "statementMovement", facts: movementFacts });
    }
  }
  return { kind, facts, entries };
}

// src/evidence.ts
function isMetadata(value) {
  if (typeof value !== "object" || value === null) return false;
  const row = value;
  return ["doc_id", "customer_id", "type", "title", "dated", "file"].every((key) => {
    const field3 = row[key];
    return typeof field3 === "string" && field3.trim().length > 0;
  });
}
function within(base, file) {
  const rel = relative(base, file);
  return rel !== "" && rel !== ".." && !rel.startsWith(`..${sep}`) && !isAbsolute(rel);
}
function loadEvidenceIndex(institutionDir) {
  const root = realpathSync(institutionDir);
  const indexFile = realpathSync(resolve(root, "evidence.jsonl"));
  if (!within(root, indexFile)) throw new Error("evidence.jsonl resolves outside the institution directory");
  const evidenceDir = resolve(root, "evidence");
  const rows = /* @__PURE__ */ new Map();
  const customers = /* @__PURE__ */ new Map();
  const cache = /* @__PURE__ */ new Map();
  const damagedCustomers = /* @__PURE__ */ new Set();
  const markDamaged = (row) => {
    const customer = typeof row === "object" && row !== null ? row.customer_id : void 0;
    if (typeof customer === "string" && customer.trim()) damagedCustomers.add(customer);
  };
  for (const [i, line] of stripBom(readFileSync(indexFile, "utf8")).split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    const location = `${indexFile}:${i + 1}`;
    let row;
    try {
      row = JSON.parse(line);
    } catch {
      warn(`${location}: skipped invalid JSON`);
      continue;
    }
    if (!isMetadata(row)) {
      warn(`${location}: skipped invalid evidence metadata`);
      markDamaged(row);
      continue;
    }
    const first = rows.get(row.doc_id);
    if (first) {
      warn(`${location}: skipped duplicate evidence ID ${row.doc_id}`);
      markDamaged(row);
      markDamaged(first);
      continue;
    }
    if (isAbsolute(row.file) || !row.file.endsWith(".md") || !within(evidenceDir, resolve(root, row.file))) {
      warn(`${location}: skipped ${row.doc_id}, which is not a relative Markdown path under evidence/`);
      markDamaged(row);
      continue;
    }
    rows.set(row.doc_id, row);
    const documents = customers.get(row.customer_id) ?? [];
    documents.push(row);
    customers.set(row.customer_id, documents);
  }
  function load(row) {
    const existing = cache.get(row.doc_id);
    if (existing) return existing;
    let markdown;
    try {
      const file = realpathSync(resolve(root, row.file));
      if (!within(evidenceDir, file)) throw new Error("document resolves outside the evidence directory");
      markdown = stripBom(readFileSync(file, "utf8"));
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      throw new Error(`Cannot read evidence ${row.doc_id} (${row.file}): ${message}`, { cause: error });
    }
    const document = { metadata: row, markdown, extraction: extractEvidence(row.doc_id, row.type, markdown) };
    cache.set(row.doc_id, document);
    return document;
  }
  return {
    metadataForCustomer: (customerId) => [...customers.get(customerId) ?? []],
    get: (docId) => {
      const row = rows.get(docId);
      return row && load(row);
    },
    documentsForCustomer: (customerId) => (customers.get(customerId) ?? []).map(load),
    damagedCustomers
  };
}

// src/bank-cases.ts
var institutions = ["bank", "emoney", "investment", "payments_fx"];
var isRow = (value) => typeof value === "object" && value !== null && !Array.isArray(value);
var text = (value) => typeof value === "string" && value.trim().length > 0;
var ids = (value) => Array.isArray(value) && value.every(text) && new Set(value).size === value.length;
var nullableText = (value) => value === null || text(value);
function isDay(value) {
  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
  const date = /* @__PURE__ */ new Date(`${value}T00:00:00Z`);
  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
}
function bankCase(row) {
  const w = row.review_window;
  return text(row.case_id) && text(row.customer_id) && institutions.some((value) => value === row.institution) && ids(row.alert_ids) && (row.held_payment_id === void 0 || nullableText(row.held_payment_id)) && isRow(w) && isDay(w.from) && isDay(w.to) && w.from <= w.to;
}
function bankAlert(row) {
  return text(row.alert_id) && text(row.case_id) && text(row.customer_id) && text(row.rule_id) && ids(row.transaction_ids);
}
function bankTransaction(row) {
  return text(row.transaction_id) && text(row.customer_id) && text(row.booked_at) && isDay(row.booked_at.slice(0, 10)) && Number.isFinite(Date.parse(row.booked_at)) && (row.direction === "in" || row.direction === "out") && typeof row.amount_gbp === "number" && Number.isFinite(row.amount_gbp) && row.amount_gbp >= 0 && nullableText(row.counterparty_name) && nullableText(row.counterparty_account);
}
function bankCustomer(row) {
  return text(row.customer_id) && text(row.name);
}
function indexRows(path, valid, idKey, damaged) {
  const result = /* @__PURE__ */ new Map();
  const markDamaged = (row) => {
    if (isRow(row) && text(row.customer_id)) damaged.add(row.customer_id);
  };
  for (const [i, line] of stripBom(readFileSync2(path, "utf8")).split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    let row;
    try {
      row = JSON.parse(line);
    } catch {
      warn(`${path}:${i + 1}: skipped invalid JSON`);
      continue;
    }
    if (!isRow(row) || !valid(row)) {
      warn(`${path}:${i + 1}: skipped invalid row`);
      markDamaged(row);
      continue;
    }
    const id = row[idKey];
    const first = result.get(id);
    if (first) {
      warn(`${path}:${i + 1}: skipped duplicate ID ${String(id)}`);
      markDamaged(row);
      markDamaged(first);
      continue;
    }
    result.set(id, row);
  }
  return result;
}
function indexCases(path) {
  const order = [];
  const valid = /* @__PURE__ */ new Map();
  const seen = /* @__PURE__ */ new Set();
  for (const [i, line] of stripBom(readFileSync2(path, "utf8")).split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    let row;
    try {
      row = JSON.parse(line);
    } catch {
      warn(`${path}:${i + 1}: skipped invalid JSON; no case ID can be recovered`);
      continue;
    }
    if (!isRow(row) || !text(row.case_id)) {
      warn(`${path}:${i + 1}: skipped a row without a case ID`);
      continue;
    }
    if (seen.has(row.case_id)) {
      warn(`${path}:${i + 1}: skipped duplicate case ID ${row.case_id}`);
      continue;
    }
    seen.add(row.case_id);
    const alertIds = Array.isArray(row.alert_ids) ? row.alert_ids.filter(text) : [];
    order.push({ case_id: row.case_id, alert_ids: alertIds });
    if (bankCase(row)) valid.set(row.case_id, row);
    else warn(`${path}:${i + 1}: case ${row.case_id} is malformed and will be escalated`);
  }
  return { order, valid };
}
function listEntry(row) {
  return text(row.entry_id) && text(row.name);
}
function previousReview(row) {
  return text(row.review_id) && text(row.customer_id) && typeof row.note === "string";
}
function groupByCustomer(rows) {
  const groups = /* @__PURE__ */ new Map();
  for (const row of rows) {
    const group = groups.get(row.customer_id);
    if (group) group.push(row);
    else groups.set(row.customer_id, [row]);
  }
  return groups;
}
function loadCases(directory, bankDiagnostic) {
  const root = realpathSync2(directory);
  function input(name) {
    const path = realpathSync2(join(root, name));
    const sub = relative2(root, path);
    if (!sub || sub === ".." || sub.startsWith(`..${sep2}`) || isAbsolute2(sub)) {
      throw new Error(`${name} resolves outside the institution directory`);
    }
    return path;
  }
  const damaged = /* @__PURE__ */ new Set();
  const { order, valid: cases } = indexCases(input("cases.jsonl"));
  const alerts = indexRows(input("alerts.jsonl"), bankAlert, "alert_id", damaged);
  const transactions = indexRows(input("transactions.jsonl"), bankTransaction, "transaction_id", damaged);
  const customers = indexRows(input("customers.jsonl"), bankCustomer, "customer_id", damaged);
  const evidence = loadEvidenceIndex(root);
  const caseInstitutions = new Set([...cases.values()].map((record4) => record4.institution));
  if (bankDiagnostic && [...caseInstitutions].some((value) => value !== "bank")) throw new Error("Expected Bank case records");
  if (caseInstitutions.size > 1) warn(`cases.jsonl mixes institutions (${[...caseInstitutions].join(", ")})`);
  const txByCustomer = groupByCustomer(transactions.values());
  const internalList = bankDiagnostic ? [] : [...indexRows(input("internal_list.jsonl"), listEntry, "entry_id", damaged).values()];
  const reviewsByCustomer = groupByCustomer(bankDiagnostic ? [] : indexRows(input("previous_reviews.jsonl"), previousReview, "review_id", damaged).values());
  function get(caseId) {
    const caseRecord = cases.get(caseId);
    if (!caseRecord) throw new Error(order.some((stub) => stub.case_id === caseId) ? `${caseId}: malformed case record` : `Unknown case ${caseId}`);
    if (damaged.has(caseRecord.customer_id) || evidence.damagedCustomers.has(caseRecord.customer_id)) {
      throw new Error(`${caseId}: some input records for customer ${caseRecord.customer_id} could not be read`);
    }
    const customer = customers.get(caseRecord.customer_id);
    if (!customer) throw new Error(`${caseId}: missing customer ${caseRecord.customer_id}`);
    const flagged = /* @__PURE__ */ new Map();
    const caseAlerts = caseRecord.alert_ids.map((id) => {
      const alert = alerts.get(id);
      if (!alert || alert.case_id !== caseId || alert.customer_id !== customer.customer_id) {
        throw new Error(`${caseId}: missing or unrelated alert ${id}`);
      }
      for (const transactionId of alert.transaction_ids) {
        const tx = transactions.get(transactionId);
        if (!tx || tx.customer_id !== customer.customer_id) {
          throw new Error(`${caseId}: alert ${id} refers to missing or unrelated transaction ${transactionId}`);
        }
        flagged.set(transactionId, tx);
      }
      return alert;
    });
    const heldPayment = caseRecord.held_payment_id ? transactions.get(caseRecord.held_payment_id) : void 0;
    if (caseRecord.held_payment_id && (!heldPayment || heldPayment.customer_id !== customer.customer_id || heldPayment.direction !== "out")) {
      throw new Error(`${caseId}: missing or unrelated held payment ${caseRecord.held_payment_id}`);
    }
    const { from, to } = caseRecord.review_window;
    const priorTransactions = [];
    const windowTransactions = [];
    for (const tx of txByCustomer.get(customer.customer_id) ?? []) {
      const day = tx.booked_at.slice(0, 10);
      if (day < from) priorTransactions.push(tx);
      else if (day <= to) windowTransactions.push(tx);
    }
    return {
      caseRecord,
      customer,
      alerts: caseAlerts,
      flaggedTransactions: [...flagged.values()],
      documents: evidence.documentsForCustomer(customer.customer_id),
      windowTransactions,
      priorTransactions,
      heldPayment,
      previousReviews: reviewsByCustomer.get(customer.customer_id) ?? [],
      internalList
    };
  }
  const stubs = new Map(order.map((stub) => [stub.case_id, stub]));
  return { root, caseIds: order.map((stub) => stub.case_id), get, stub: (caseId) => stubs.get(caseId) };
}
function loadInstitutionCases(directory) {
  return loadCases(directory, false);
}

// src/reconciliation.ts
var normalize = (s) => s.trim().replace(/\s+/g, " ").toLowerCase();
function minor(amount) {
  const parts = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(amount));
  const minor2 = parts && Number(parts[1] + (parts[2] ?? "").padEnd(2, "0"));
  return typeof minor2 === "number" && Number.isSafeInteger(minor2) ? minor2 : void 0;
}

// src/documented-credits.ts
function one(items) {
  return items.length === 1 ? items[0] : void 0;
}
function field(markdown, label5) {
  return one([...markdown.matchAll(new RegExp(`^\\*\\*${label5}:\\*\\*[ \\t]*(.+)$`, "gim"))].map((match) => match[1].trim()));
}
function refMatches(text2, kind) {
  const matches = [...text2.matchAll(new RegExp(`\\b${kind}[ \\t]+(?=[A-Z0-9-]*\\d)[A-Z0-9]+(?:-[A-Z0-9]+)*\\b`, "gi"))];
  return one([...new Set(matches.map((m) => normalize(m[0])))]);
}
function oneAmount(text2) {
  const amounts = [...text2.matchAll(/£[ \t]*[\d,]+(?:\.\d+)?/g)];
  const amount = one(amounts);
  return amount && parseGbp(amount[0])?.minorUnits;
}
function terms(doc, customerName) {
  const { markdown } = doc;
  if (doc.metadata.type === "insurer_letter") {
    const issuer = /^# Claim settlement letter from (.+)$/im.exec(markdown)?.[1]?.trim();
    const salutation = /^Dear[ \t]+(.+?),[ \t]*$/im.exec(markdown)?.[1];
    const recipient = String.raw`((?:(?!\bto\b)[^\n.,*])+?)`;
    const payees = [...new Set([
      new RegExp(String.raw`\bto[ \t]+${recipient}[ \t]+(?:via|by)[ \t]+bank transfer\b`, "gi"),
      new RegExp(String.raw`\bbank transfer[ \t]+(?:directly[ \t]+)?to[ \t]+${recipient}[.,]`, "gi"),
      new RegExp(String.raw`\b(?:issued|paid|transferred|remitted)(?:[ \t]+directly)?[ \t]+to[ \t]+${recipient}(?:[ \t]+(?:by|via)\b|[.,])`, "gi"),
      new RegExp(String.raw`\bpayment of \**£[\d,.]+\**[ \t]+to[ \t]+${recipient}(?:[ \t]+(?:by|via)\b|[.,])`, "gi")
    ].flatMap((pattern) => [...markdown.matchAll(pattern)].map((match) => normalize(match[1]))).filter((name) => !/^(?:the|a|an|our)\b/.test(name)))];
    const payeesOk = payees.every((payee) => /^(?:you|your(?: nominated)? (?:bank )?account)$/.test(payee) || payee === normalize(customerName));
    const genericSalutation = !salutation || /^(?:sir|madam|sir\/madam|customer|client|policyholder)$/i.test(salutation.trim());
    const addressed = salutation ? normalize(salutation) === normalize(customerName) : false;
    const named = payees.some((payee) => payee === normalize(customerName));
    const reference = refMatches(markdown, "claim");
    const amount = oneAmount(markdown);
    const accepted = /\b(?:accepted|approved)\b/i.test(markdown);
    const disputed = /\b(?:not (?:yet )?(?:been )?(?:accepted|approved)|declined|rejected|subject to approval|pending|provisional|partial|cannot confirm|can['’]t confirm|unable to confirm|will not pay|under review|withheld|on hold)\b/i.test(markdown);
    if (issuer && reference && amount && accepted && !disputed && payeesOk && (addressed || named || genericSalutation)) {
      return { kind: "insurance_payout", party: issuer, amount, reference };
    }
  }
  if (doc.metadata.type === "venue_email") {
    const issuer = /^# Email from (.+)$/im.exec(markdown)?.[1]?.trim();
    const reference = refMatches(markdown, "booking");
    const amount = oneAmount(markdown);
    if (issuer && reference && amount && /\bcancel/i.test(markdown) && /\brefund\b/i.test(markdown) && !/\b(?:no refund|not refunded|non.refundable|not refunding|unable to refund|partial refund|refund (?:is )?(?:declined|denied|not due|not issued)|will not (?:be )?refund|forfeited|retained)\b/i.test(markdown)) {
      return { kind: "refund", party: issuer, amount, reference };
    }
  }
  if (doc.metadata.type === "credit_note") {
    const issuer = /^# Credit note from (.+)$/im.exec(markdown)?.[1]?.trim();
    const supplier = field(markdown, "Supplier");
    const customer = field(markdown, "Customer");
    const cause = field(markdown, "Credit for");
    const refund = field(markdown, "Refund");
    const reference = cause && refMatches(cause, "booking");
    const amount = refund && parseGbp(refund)?.minorUnits;
    if (issuer && supplier && (normalize(supplier) === normalize(issuer) || normalize(supplier).startsWith(`${normalize(issuer)}, `)) && customer && normalize(customer) === normalize(customerName) && cause && /\bcancell?ed\b/i.test(cause) && !/\b(?:not|never)\s+cancell?ed\b/i.test(cause) && reference && amount) {
      return { kind: "refund", party: issuer, amount, reference };
    }
  }
}
function mentions(text2, identifier) {
  const literal = normalize(identifier).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(`(?<![a-z0-9-])${literal}(?![a-z0-9-])`).test(normalize(text2));
}
function validDate(day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return false;
  const date = /* @__PURE__ */ new Date(`${day}T00:00:00Z`);
  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === day;
}
var txReference = (tx) => typeof tx.reference === "string" ? normalize(tx.reference) : "";
var namesParty = (tx, party) => !!tx.counterparty_name && normalize(tx.counterparty_name) === normalize(party);
function originalPayment(credit, payment, dated2, history) {
  return one(history.filter((tx) => tx.direction === "out" && tx.customer_id === payment.customer_id && Date.parse(tx.booked_at) < Date.parse(payment.booked_at) && tx.booked_at.slice(0, 10) <= dated2 && txReference(tx) === credit.reference && minor(tx.amount_gbp) === credit.amount && namesParty(tx, credit.party) && tx.counterparty_country === payment.counterparty_country));
}
function documentedCredits(pack) {
  const candidates = pack.documents.flatMap((doc) => {
    const credit = doc.metadata.customer_id === pack.customer.customer_id ? terms(doc, pack.customer.name) : void 0;
    return credit ? [{ doc, credit }] : [];
  });
  const byDocument = new Map(candidates.map(({ doc, credit }) => [doc, credit]));
  const history = [...pack.priorTransactions, ...pack.windowTransactions].filter((tx) => tx.transaction_id !== pack.heldPayment?.transaction_id);
  const matches = [];
  for (const { doc, credit } of candidates) {
    if (!validDate(doc.metadata.dated)) continue;
    const unresolved = pack.documents.some((other) => {
      if (other === doc || other.metadata.customer_id !== pack.customer.customer_id) return false;
      if (mentions(other.markdown, doc.metadata.doc_id) && /\b(?:forged|altered|fabricat\w*|unverified|could not verify|suspicious)\b/i.test(other.markdown)) return true;
      if (!mentions(other.markdown, credit.reference)) return false;
      const terms2 = byDocument.get(other);
      return !terms2 || terms2.kind !== credit.kind || terms2.reference !== credit.reference || terms2.amount !== credit.amount || normalize(terms2.party) !== normalize(credit.party);
    });
    if (unresolved) continue;
    const reference = credit.kind === "refund" ? `refund ${credit.reference}` : credit.reference;
    const payment = one(history.filter((tx) => tx.direction === "in" && tx.customer_id === pack.customer.customer_id && txReference(tx) === reference && minor(tx.amount_gbp) === credit.amount && namesParty(tx, credit.party)));
    if (!payment) continue;
    const day = payment.booked_at.slice(0, 10);
    const { from, to } = pack.caseRecord.review_window;
    if (day < from || day > to || doc.metadata.dated > day) continue;
    const original = credit.kind === "refund" ? originalPayment(credit, payment, doc.metadata.dated, history) : void 0;
    if (credit.kind === "refund" && !original) continue;
    matches.push({ kind: credit.kind, reference: credit.reference.toUpperCase(), documentId: doc.metadata.doc_id, payment, original });
  }
  const counts = /* @__PURE__ */ new Map();
  for (const { payment } of matches) counts.set(payment.transaction_id, (counts.get(payment.transaction_id) ?? 0) + 1);
  return new Map(matches.filter(({ payment }) => counts.get(payment.transaction_id) === 1).map((match) => [match.payment.transaction_id, match]));
}

// src/text.ts
var MONTHS = [
  "january",
  "february",
  "march",
  "april",
  "may",
  "june",
  "july",
  "august",
  "september",
  "october",
  "november",
  "december"
];
function norm(value) {
  return value.normalize("NFKD").replace(/[̀-ͯ]/g, "").replace(/[’‘`]/g, "'").replace(/\s+/g, " ").trim().toLowerCase();
}
function nameKey(value) {
  return norm(value).replace(/\bpublic limited company\b/g, "plc").replace(/\blimited\b/g, "ltd").replace(/&/g, " and ").replace(/[^a-z0-9]/g, "");
}
function sameName(a, b) {
  return !!a && !!b && !!nameKey(a) && nameKey(a) === nameKey(b);
}
function surname(name) {
  const parts = norm(name).split(" ");
  return parts[parts.length - 1] ?? "";
}
var MONEY = /£\s?((?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d{1,2})?)/g;
function poundsIn(text2) {
  return [...text2.matchAll(MONEY)].flatMap((match) => {
    const [whole, fraction = ""] = match[1].replaceAll(",", "").split(".");
    const pence2 = Number(whole + fraction.padEnd(2, "0"));
    return Number.isSafeInteger(pence2) ? [pence2] : [];
  });
}
function onlyPounds(text2) {
  const amounts = [...new Set(poundsIn(text2))];
  return amounts.length === 1 ? amounts[0] : void 0;
}
function pounds(text2) {
  return text2 === void 0 ? void 0 : poundsIn(text2)[0];
}
function pence(amount) {
  const parts = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(amount));
  const value = parts && Number(parts[1] + (parts[2] ?? "").padEnd(2, "0"));
  return typeof value === "number" && Number.isSafeInteger(value) ? value : void 0;
}
function samePence(tx, amount) {
  return amount !== void 0 && amount > 0 && pence(tx.amount_gbp) === amount;
}
function isoDay(text2) {
  if (!text2) return;
  const value = text2.trim();
  let iso = value;
  const named = /^(\d{1,2})(?:st|nd|rd|th)?\s+([A-Za-z]+)\s+(\d{4})$/.exec(value);
  if (named) {
    const month = MONTHS.indexOf(named[2].toLowerCase()) + 1;
    if (!month) return;
    iso = `${named[3]}-${String(month).padStart(2, "0")}-${named[1].padStart(2, "0")}`;
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
  const date = /* @__PURE__ */ new Date(`${iso}T00:00:00Z`);
  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === iso ? iso : void 0;
}
function isoMonth(text2) {
  const match = text2 && /^([A-Za-z]+)\s+(\d{4})$/.exec(text2.trim());
  if (!match) return;
  const month = MONTHS.indexOf(match[1].toLowerCase()) + 1;
  return month ? `${match[2]}-${String(month).padStart(2, "0")}` : void 0;
}
function daysBetween(from, to) {
  return Math.round((Date.parse(`${to.slice(0, 10)}T00:00:00Z`) - Date.parse(`${from.slice(0, 10)}T00:00:00Z`)) / 864e5);
}
var txDay = (tx) => tx.booked_at.slice(0, 10);
function fields(markdown, label5) {
  const escaped = label5.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return [...markdown.matchAll(new RegExp(`^[ \\t]*(?:[*-][ \\t]+)?\\*\\*${escaped}:\\*\\*[ \\t]*(.+?)[ \\t]*$`, "gim"))].map((match) => match[1].trim());
}
function field2(markdown, label5) {
  const values = [...new Set(fields(markdown, label5))];
  return values.length === 1 ? values[0] : void 0;
}
function title(markdown) {
  return /^#\s+(.+)$/m.exec(markdown)?.[1].trim() ?? "";
}
function tableRows(markdown, required) {
  const lines = markdown.split(/\r?\n/).map((line) => line.trim());
  const cells = (line) => line.slice(1, -1).split("|").map((cell) => cell.trim());
  for (let i = 0; i + 1 < lines.length; i++) {
    if (!lines[i].startsWith("|") || !/^\|(?:\s*:?-{3,}:?\s*\|)+$/.test(lines[i + 1])) continue;
    const headers = cells(lines[i]).map((header) => header.toLowerCase());
    if (!required.every((header) => headers.includes(header))) continue;
    const rows = [];
    for (let j = i + 2; j < lines.length && lines[j].startsWith("|"); j++) {
      const row = cells(lines[j]);
      if (row.length !== headers.length) continue;
      rows.push(Object.fromEntries(headers.map((header, k) => [header, row[k]])));
    }
    return rows;
  }
  return [];
}
function accountKey(value) {
  if (!value) return;
  const text2 = value.trim().replace(/^(?:account|acct)\s+(?:number\s+)?/i, "");
  const ending = /^(?:(?:iban|account)\s+)?ending\s+([A-Z0-9]{3,6})$/i.exec(text2);
  if (ending) return `ending:${ending[1].toUpperCase()}`;
  const compact = text2.replace(/[\s-]/g, "").toUpperCase();
  if (/^\d{14}$/.test(compact) || /^[A-Z]{2}\d{2}[A-Z0-9]{11,30}$/.test(compact)) return compact;
}
function sameAccount(a, b) {
  const left = accountKey(a);
  return !!left && left === accountKey(b);
}
var COMPANY = /\b(?:ltd|limited|llp|plc|inc|co|corp|corporation|company|gmbh|bv|nv|srl|sarl|sal|fze|llc|sa|spa|ag|sp\.? z o\.?o\.?|bank|banco|exchange|council|trust|group|holdings|services|partners|ventures|finance|insurance|assurance|society|university|hospital|clinic|school|homes|lettings|travel|motors)\b/i;
function looksLikeOrganization(name) {
  return !!name && COMPANY.test(name);
}
var HIGHER_RISK_COUNTRIES = /* @__PURE__ */ new Set([
