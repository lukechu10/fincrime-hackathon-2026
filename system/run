          fact: `${doc.metadata.doc_id} records ${label(ctx.name)} selling ${registration ? `vehicle ${registration}` : "an item"} to ${buyer ?? "a buyer"} for cash equal to ${describe(tx)}`
        });
      }
    }
  }
}
