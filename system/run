    const registration = /registration ([A-Z]{2}\d{2} ?[A-Z]{3})/.exec(doc.markdown)?.[1];
    const support = ofType(ctx, "insurance_schedule", "advert").filter((other) => other.metadata.type === "advert" ? new RegExp(`Seller:\\s*${ctx.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}`, "i").test(other.markdown) : !!registration && sameName(field2(other.markdown, "Policyholder"), ctx.name) && norm(field2(other.markdown, "Vehicle") ?? "").includes(norm(registration)));
