]);

// src/explanations.ts
var gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
var label = (s) => s.replace(/\s+/g, " ").trim();
function describe(tx) {
  return `${gbp.format(tx.amount_gbp)} ${tx.direction === "in" ? "from" : "to"} ${label(tx.counterparty_name ?? "an unidentified counterparty")} on ${txDay(tx)} (${tx.transaction_id})`;
}
function context(pack) {
  const byId = /* @__PURE__ */ new Map();
  for (const tx of [...pack.priorTransactions, ...pack.windowTransactions, ...pack.flaggedTransactions]) byId.set(tx.transaction_id, tx);
  if (pack.heldPayment) byId.set(pack.heldPayment.transaction_id, pack.heldPayment);
  const history = [...byId.values()].sort((a, b) => a.booked_at.localeCompare(b.booked_at) || a.transaction_id.localeCompare(b.transaction_id));
  const subjects = history.filter((tx) => tx.booked_at.slice(0, 10) >= pack.caseRecord.review_window.from || pack.flaggedTransactions.includes(tx) || tx === pack.heldPayment);
  const docs = pack.documents.filter((doc) => doc.metadata.customer_id === pack.customer.customer_id && !!isoDay(doc.metadata.dated));
  return { pack, name: pack.customer.name, docs, history, subjects };
}
var ofType = (ctx, ...types) => ctx.docs.filter((doc) => types.includes(doc.metadata.type));
var dated = (doc) => doc.metadata.dated;
var recentBefore = (doc, tx, days) => dated(doc) <= txDay(tx) && daysBetween(dated(doc), txDay(tx)) <= days;
var refHas = (tx, ref) => typeof tx.reference === "string" && new RegExp(`(?:^|[^a-z0-9])${norm(ref).replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?:$|[^a-z0-9])`).test(norm(tx.reference));
var fromTitle = (doc, pattern) => pattern.exec(title(doc.markdown))?.[1]?.trim();
var incoming = (ctx) => ctx.subjects.filter((tx) => tx.direction === "in");
var outgoing = (ctx) => ctx.subjects.filter((tx) => tx.direction === "out");
var isCash = (tx) => typeof tx.channel === "string" && /cash/.test(tx.channel);
function ownAccount(ctx, add) {
  for (const tx of ctx.subjects) {
    if (!tx.counterparty_account || tx.direction === void 0) continue;
    for (const doc of ofType(ctx, "bank_statement")) {
      const md = doc.markdown;
      const holder = field2(md, "Account holder");
      const holders = (field2(md, "Account holders") ?? "").split(/\s*(?:,|\band\b)\s*/).filter(Boolean);
      const accountName = field2(md, "Account name");
      const isHolder = sameName(holder, ctx.name) || holders.some((h) => sameName(h, ctx.name));
      const movements = [...md.matchAll(/^(\d{1,2} [A-Za-z]+ \d{4}):\s+(.+)$/gm)].map((m) => ({ day: isoDay(m[1]), amounts: poundsIn(m[2]), text: m[2] }));
      const moved = movements.some((m) => m.day && Math.abs(daysBetween(m.day, txDay(tx))) <= 2 && m.amounts.some((a) => samePence(tx, a)));
      const heldBy = [...md.matchAll(/Account (.+?) is held by (.+?)\.(?:\s|$)/g)].some((m) => sameName(m[2], ctx.name) && sameAccount(m[1], tx.counterparty_account));
      const account = field2(md, "Account");
      const named = !tx.counterparty_name || sameName(tx.counterparty_name, ctx.name) || sameName(tx.counterparty_name, accountName) || isHolder && holders.some((h) => sameName(h, tx.counterparty_name));
      const ok = heldBy && moved || isHolder && named && sameAccount(account, tx.counterparty_account) && (!/ending/i.test(account ?? "") || moved);
      if (!ok) continue;
      add(tx, {
        code: "OWN_ACCOUNT",
        docs: [doc.metadata.doc_id],
        related: [],
        fact: `${doc.metadata.doc_id} shows ${label(ctx.name)} holds the account used for ${describe(tx)}`
      });
      break;
    }
  }
}
function invoices(ctx, add) {
  const matches = [];
  const conflicts = [];
  const docCounts = /* @__PURE__ */ new Map();
  const txCounts = /* @__PURE__ */ new Map();
  const relevant = new Set(ctx.subjects.map((tx) => tx.transaction_id));
  for (const doc of ofType(ctx, "supplier_invoice", "invoice", "carrier_invoice")) {
    const md = doc.markdown;
    if (doc.extraction.entries.length || tableRows(md, ["invoice", "amount"]).length || /instal+ments?/i.test(md)) continue;
    const titleIssuer = fromTitle(doc, /\bfrom (.+)$/i);
    const issuers = ["Supplier", "Carrier"].flatMap((key) => fields(md, key).map((value) => value.split(",")[0]));
    if (titleIssuer) issuers.push(titleIssuer);
    const buyers = ["Buyer", "Bill to"].flatMap((key) => fields(md, key));
    const amounts = ["Amount", "Amount due", "Total"].flatMap((key) => fields(md, key));
    const amount = amounts.length === 1 ? parseGbp(amounts[0])?.minorUnits : void 0;
    const dates = fields(md, "Dated");
    const destinations = fields(md, "Pay to");
    if (!buyers.length || buyers.some((buyer) => !sameName(buyer, ctx.name)) || !amount || destinations.length > 1 || dates.some((date) => isoDay(date) !== dated(doc))) continue;
    const payTo = destinations[0];
    const namedDestination = payTo && /^(.+?),\s*((?:IBAN|account)\b.+)$/i.exec(payTo);
    const accountOnly = payTo && /^(?:IBAN|account)\b/i.test(payTo);
    const payee = namedDestination ? namedDestination[1] : accountOnly ? void 0 : payTo;
    const account = namedDestination ? namedDestination[2] : accountOnly ? payTo : void 0;
    const ref = /\b(INV \d+|CARRIER \d+|PO \d+)\b/.exec(title(md))?.[1] ?? /\border (PO \d+)\b/i.exec(field2(md, "Goods") ?? "")?.[1] ?? field2(md, "Invoice number");
    if (!issuers.length && !payee) continue;
    for (const tx of ctx.history) {
      if (tx.direction === "out" && ref && refHas(tx, ref) && relevant.has(tx.transaction_id) && !samePence(tx, amount) && recentBefore(doc, tx, 60) && issuers.length > 0 && issuers.every((issuer) => sameName(tx.counterparty_name, issuer))) {
        conflicts.push({ doc, tx, detail: `bills ${amounts[0]} under ${ref}` });
        continue;
      }
      if (tx.direction !== "out" || !samePence(tx, amount) || !recentBefore(doc, tx, 60) || issuers.some((issuer) => !sameName(tx.counterparty_name, issuer)) || ref && !refHas(tx, ref)) continue;
      const accountMatches = !!account && sameAccount(account, tx.counterparty_account);
      if (payee && !sameName(payee, tx.counterparty_name)) {
        if (relevant.has(tx.transaction_id) && (ref || accountMatches)) conflicts.push({ doc, tx, detail: `names ${label(payee)} as the payment beneficiary` });
        continue;
      }
      if (account && !accountMatches) continue;
      matches.push({ doc, tx, ref });
      docCounts.set(doc, (docCounts.get(doc) ?? 0) + 1);
      txCounts.set(tx.transaction_id, (txCounts.get(tx.transaction_id) ?? 0) + 1);
    }
  }
  for (const { doc, tx, ref } of matches) {
    if (!relevant.has(tx.transaction_id) || docCounts.get(doc) !== 1 || txCounts.get(tx.transaction_id) !== 1) continue;
    const supplier = tx.counterparty_name;
    const support = ofType(ctx, "purchase_order", "supply_contract").filter((other) => dated(other) <= txDay(tx) && (other.metadata.type === "purchase_order" ? !!ref && /^PO /.test(ref) && refHasText(other.markdown, ref) : norm(other.markdown).includes(norm(supplier))));
    add(tx, {
      code: "INVOICE_MATCHES",
      docs: [doc.metadata.doc_id, ...support.map((d) => d.metadata.doc_id)],
      related: [],
      fact: `${doc.metadata.doc_id} from ${supplier} bills ${label(ctx.name)}${ref ? ` under ${ref}` : ""} and matches the payee, amount and date of ${describe(tx)}`
    });
  }
  return conflicts;
}
function heldPaymentReceipt(ctx, add) {
  const held = ctx.pack.heldPayment;
  if (ctx.pack.caseRecord.institution !== "payments_fx" || !held) return;
  const matches = ofType(ctx, "receipt").filter((doc) => {
    const merchant = fromTitle(doc, /^Receipt from (.+)$/i);
    const day = dated(doc);
    const amounts = [...doc.markdown.matchAll(/\bwe(?:['’]ve| have) (?:successfully )?(?:received|processed) your payment of (£[\d,.]+)(?=[.!?\s]|$)/gi)];
    if (amounts.length !== 1 || !sameName(merchant, held.counterparty_name) || txDay(held) !== day || isoDay(field2(doc.markdown, "Dated")) !== day || /\b(?:not received|not processed|not yet|pending|partial payment|declined|reversed|refunded)\b/i.test(doc.markdown)) return false;
    const amount = parseGbp(amounts[0][1].replace(/\.$/, ""))?.minorUnits;
    if (!samePence(held, amount)) return false;
    const transactions = ctx.history.filter((tx) => tx.direction === "out" && txDay(tx) === day && sameName(tx.counterparty_name, merchant) && samePence(tx, amount));
    return transactions.length === 1;
  });
  if (matches.length !== 1) return;
  add(held, {
    code: "WITHIN_PROFILE",
    docs: [matches[0].metadata.doc_id],
    related: [],
    fact: `Merchant receipt ${matches[0].metadata.doc_id} documents the order and matches the payee, amount and date of ${describe(held)}`
  });
}
function credits(ctx, add) {
  for (const credit of documentedCredits(ctx.pack).values()) {
    const refund = credit.kind === "refund";
    add(credit.payment, {
      code: refund ? "REFUND_OF_EARLIER_PAYMENT" : "DOCUMENTED_EVENT",
      docs: [credit.documentId],
      related: credit.original ? [credit.original.transaction_id] : [],
      fact: credit.original ? `${credit.documentId} records ${credit.reference} and links the refund of ${describe(credit.payment)} to the original payment of ${describe(credit.original)}` : `${credit.documentId} records the accepted ${credit.reference} for ${label(ctx.name)} and matches the payout of ${describe(credit.payment)}`
    });
  }
}
function payroll(ctx, add) {
  const employer = typeof ctx.pack.customer.employer === "string" ? ctx.pack.customer.employer : void 0;
  const declared = ctx.pack.customer.declared;
  const source = typeof declared?.source_of_funds === "string" ? norm(declared.source_of_funds) : "";
  if (!employer || !/salary|employment/.test(source)) return;
  for (const tx of incoming(ctx)) {
    if (sameName(tx.counterparty_name, employer) && typeof tx.reference === "string" && /^salary\b/.test(norm(tx.reference))) {
      add(tx, { code: "WITHIN_PROFILE", docs: [], related: [], fact: `${describe(tx)} is salary from the declared employer` });
    }
  }
}
function settlementLetters(ctx, add) {
  for (const doc of ofType(ctx, "settlement_letter")) {
    const payer = fromTitle(doc, /^Settlement agreement letter from (.+)$/i);
    const amount = onlyPounds(doc.markdown);
    if (!payer || amount === void 0) continue;
    for (const tx of incoming(ctx)) {
      if (sameName(tx.counterparty_name, payer) && samePence(tx, amount) && recentBefore(doc, tx, 30) && (!tx.reference || /settlement/i.test(String(tx.reference)))) {
        add(tx, {
          code: "DOCUMENTED_EVENT",
          docs: [doc.metadata.doc_id],
          related: [],
          fact: `${doc.metadata.doc_id} confirms a settlement payment from ${payer} of the same amount as ${describe(tx)}`
        });
      }
    }
  }
}
function solicitorLetters(ctx, add) {
  for (const doc of ofType(ctx, "solicitor_letter")) {
    const firm = fromTitle(doc, /^Letter from (.+)$/i);
    const deceased = /[Ee]state of the late ([A-Z][A-Za-z'’-]+(?: [A-Z][A-Za-z'’-]+)+)/.exec(doc.markdown)?.[1];
    const amount = onlyPounds(doc.markdown);
    if (!firm || !deceased || amount === void 0) continue;
    for (const tx of incoming(ctx)) {
      const payerOk = !!tx.counterparty_name && nameKey(tx.counterparty_name).startsWith(nameKey(firm));
      const refOk = !tx.reference || !/estate/i.test(String(tx.reference)) || norm(String(tx.reference)).includes(norm(deceased));
      if (payerOk && refOk && samePence(tx, amount) && recentBefore(doc, tx, 30)) {
        add(tx, {
          code: "DOCUMENTED_EVENT",
          docs: [doc.metadata.doc_id],
          related: [],
          fact: `${doc.metadata.doc_id} from ${firm} confirms ${label(ctx.name)}'s inheritance from the estate of ${deceased}, matching ${describe(tx)}`
        });
      }
    }
  }
}
function completionStatements(ctx, add) {
  for (const doc of ofType(ctx, "completion_statement")) {
    const firm = fromTitle(doc, /^Completion statement from (.+)$/i);
    const paid = pounds(/\*\*Paid to[^*]*:\*\*\s*(£[\d,.]+)/i.exec(doc.markdown)?.[1]);
    const [sale, mortgage, fees] = ["Sale price", "Mortgage redeemed", "Fees"].map((l) => pounds(field2(doc.markdown, l)));
    if (!firm || paid === void 0 || !sameName(field2(doc.markdown, "Client"), ctx.name)) continue;
    if (sale !== void 0 && mortgage !== void 0 && fees !== void 0 && Math.abs(sale - mortgage - fees - paid) > 2) continue;
    for (const tx of incoming(ctx)) {
      if (tx.counterparty_name && nameKey(tx.counterparty_name).startsWith(nameKey(firm)) && samePence(tx, paid) && recentBefore(doc, tx, 30)) {
        add(tx, {
          code: "DOCUMENTED_EVENT",
          docs: [doc.metadata.doc_id],
          related: [],
          fact: `${doc.metadata.doc_id} from ${firm} shows ${label(ctx.name)}'s property sale proceeds paid as ${describe(tx)}`
        });
      }
    }
  }
}
function giftLetter(doc) {
  if (doc.metadata.type !== "gift_letter") return;
  const donor = fromTitle(doc, /^Gift letter from (.+)$/i);
  if (!donor) return;
  const bornText = /\bborn(?: on)? (\d{1,2} [A-Za-z]+ \d{4})|\(DOB:?\s*([^)]+)\)/i.exec(doc.markdown);
  const born = isoDay(bornText?.[1] ?? bornText?.[2]);
  const recipient = /\bto my [a-z -]{1,30}?,\s*([A-Z][A-Za-z'’-]+(?: [A-Z][A-Za-z'’-]+)+)/.exec(doc.markdown)?.[1];
  return { donor, born, recipient, amount: poundsIn(doc.markdown)[0] };
}
function giftLetters(ctx, add) {
  for (const doc of ofType(ctx, "gift_letter")) {
    const gift = giftLetter(doc);
    if (!gift?.recipient || !sameName(gift.recipient, ctx.name)) continue;
    for (const tx of incoming(ctx)) {
      if (sameName(tx.counterparty_name, gift.donor) && samePence(tx, gift.amount) && recentBefore(doc, tx, 30)) {
        add(tx, {
          code: "THIRD_PARTY_DOCUMENTED",
          docs: [doc.metadata.doc_id],
          related: [],
          fact: `${doc.metadata.doc_id} is a signed gift letter from ${gift.donor} to ${label(ctx.name)} for the amount of ${describe(tx)}`
        });
      }
    }
  }
}
function saleParties(md) {
  const person = String.raw`([A-Z][A-Za-z'’-]+(?: [A-Z][A-Za-z'’-]+)+)`;
  const seller = field2(md, "Seller")?.split(",")[0] ?? new RegExp(String.raw`\bfrom ${person} to ${person}`).exec(md)?.[1] ?? new RegExp(String.raw`\bI, ${person}, (?:hereby |have (?:today |this day )?)?(?:sold|confirm the sale|acknowledge the sale)`).exec(md)?.[1] ?? new RegExp(String.raw`\b${person} has sold\b`).exec(md)?.[1] ?? new RegExp(String.raw`^Seller:\s*${person}`, "m").exec(md)?.[1];
  const buyer = field2(md, "Buyer")?.split(",")[0] ?? new RegExp(String.raw`\bfrom ${person} to ${person}`).exec(md)?.[2] ?? new RegExp(String.raw`\bto ${person}(?:\.| for\b|,)`).exec(md)?.[1] ?? new RegExp(String.raw`^Buyer:\s*${person}`, "m").exec(md)?.[1] ?? new RegExp(String.raw`Received from ${person}`).exec(md)?.[1];
  return { seller, buyer };
}
