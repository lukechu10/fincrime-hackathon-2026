// src/evidence-extraction.ts
var invoiceFields = {
  "bill to": "billedTo",
  buyer: "buyer",
  customer: "customer",
  patient: "patient",
  supplier: "supplier",
  carrier: "carrier",
  description: "description",
  goods: "goods",
  service: "service",
  treatment: "treatment",
  vehicle: "vehicle",
  terms: "terms"
};
var statementFields = {
  "account holder": "accountHolder",
  "account holders": "accountHolders",
  "account name": "accountName",
  bank: "bank",
  account: "account"
};
var companyFields = {
  company: "company",
  "company number": "companyNumber",
  "registered office": "registeredOffice",
  "nature of business": "natureOfBusiness",
  status: "companyStatus"
};
var invoiceAmounts = {
  "amount due": "amountDue",
  amount: "amount",
  total: "total",
  price: "price",
  "paid by bank transfer": "amountPaidByTransfer"
};
var invoiceTypes = /* @__PURE__ */ new Set([
  "invoice",
  "dealer_invoice",
  "hospital_invoice",
  "supplier_invoice",
  "supplier_invoices",
  "carrier_invoice",
  "freight_invoices"
]);
var registerTypes = /* @__PURE__ */ new Set(["company_register_extract", "significant_control_register"]);
var months = "January February March April May June July August September October November December".split(" ");
var gbpNumber = String.raw`(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d{2})?`;
function parseGbp(text2) {
  const match = new RegExp(`^\xA3\\s*(${gbpNumber})$`).exec(text2);
  if (!match) return;
  const [pounds, pence = "00"] = match[1].replaceAll(",", "").split(".");
  const minorUnits = Number(pounds + pence);
  if (Number.isSafeInteger(minorUnits)) return { currency: "GBP", minorUnits };
}
function parseDate(text2) {
  const named = /^(\d{1,2}) ([A-Za-z]+) (\d{4})$/.exec(text2);
  let normalized = text2;
  if (named) {
    const [, day, name, year] = named;
    const month = months.findIndex((m) => m.toLowerCase() === name.toLowerCase()) + 1;
    if (!month) return;
    normalized = `${year}-${String(month).padStart(2, "0")}-${day.padStart(2, "0")}`;
  } else if (!/^\d{4}-\d{2}-\d{2}$/.test(text2)) {
    return;
  }
  const date = /* @__PURE__ */ new Date(`${normalized}T00:00:00Z`);
  if (Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === normalized) return normalized;
}
function textFact(out, field2, value, source) {
  if (value && value !== "\u2014" && value !== "-") out.push({ field: field2, value, source });
}
function dateFact(out, field2, value, source) {
  textFact(out, field2, value && parseDate(value), source);
}
function amountFact(out, field2, value, source) {
  const normalized = value && parseGbp(value);
  if (normalized) out.push({ field: field2, value: normalized, source });
}
function lookup(map, key) {
  return Object.hasOwn(map, key) ? map[key] : void 0;
}
function tableEntry(kind, cells, headers, source) {
  if (cells.length !== headers.length) return;
  const get = (label2) => cells[headers.indexOf(label2)];
  const facts = [];
  if (kind === "invoice" && headers.includes("invoice") && headers.includes("amount")) {
    textFact(facts, "invoiceNumber", get("invoice"), source);
    dateFact(facts, "invoiceDate", get("dated"), source);
    textFact(facts, "goods", get("goods"), source);
    textFact(facts, "exporter", get("exporter"), source);
    amountFact(facts, "amount", get("amount"), source);
    return { kind: "invoiceLine", facts };
  }
  if (kind !== "companyRegister") return;
  const isOfficer = headers.includes("officer") && headers.includes("role");
  const isControl = headers.includes("control") && (headers.includes("person") || headers.includes("person with significant control"));
  if (!isOfficer && !isControl) return;
  textFact(facts, "person", get("officer") ?? get("person with significant control") ?? get("person"), source);
  textFact(facts, "role", get("role"), source);
  textFact(facts, "birthDetail", get("born"), source);
  textFact(facts, "control", get("control"), source);
  dateFact(facts, "appointedDate", get("appointed"), source);
  dateFact(facts, "resignedDate", get("resigned"), source);
  dateFact(facts, "notifiedDate", get("notified"), source);
  dateFact(facts, "ceasedDate", get("ceased"), source);
  return { kind: isOfficer ? "companyOfficer" : "significantControl", facts };
}
function invoicePayTo(facts, value, source) {
  const account = /^(.*?),\s*(account\s+.+|IBAN\s+.+)$/i.exec(value);
  if (account) {
    textFact(facts, "payee", account[1], source);
    textFact(facts, "paymentDestination", account[2], source);
  } else if (/^(IBAN|account)\b/i.test(value)) {
    textFact(facts, "paymentDestination", value, source);
  } else {
    textFact(facts, "payee", value, source);
  }
}
function extractEvidence(docId, type, markdown) {
  const kind = invoiceTypes.has(type) ? "invoice" : type === "bank_statement" ? "bankStatement" : registerTypes.has(type) ? "companyRegister" : "unparsed";
  const facts = [];
  const entries = [];
  if (kind === "unparsed") return { kind, facts, entries };
  const movementAmount = new RegExp(`^(?:transfer of\\s+|received\\s+)?(\xA3\\s*${gbpNumber})(?=\\s|$)`, "i");
  let headers;
  const lines = markdown.split(/\r?\n/);
  for (const [i, excerpt] of lines.entries()) {
    const line = excerpt.trim();
    const source = { docId, line: i + 1, excerpt };
    if (line.startsWith("|") && line.endsWith("|")) {
      const cells = line.slice(1, -1).split(/(?<!\\)\|/).map((cell) => cell.trim().replaceAll("\\|", "|"));
      const separator = lines[i + 1]?.trim();
      if (separator && /^\|(?:\s*:?-{3,}:?\s*\|)+$/.test(separator)) {
        headers = cells.map((cell) => cell.toLowerCase());
      } else if (headers && !/^\|(?:\s*:?-{3,}:?\s*\|)+$/.test(line)) {
        const entry = tableEntry(kind, cells, headers, source);
        if (entry?.facts.length) entries.push(entry);
      }
      continue;
    }
    headers = void 0;
    const heading = /^#\s+(.+)$/.exec(line);
    if (heading) textFact(facts, "title", heading[1], source);
    const field2 = /^\*\*([^*]+):\*\*\s*(.+)$/.exec(line);
    if (field2) {
      const label2 = field2[1].toLowerCase();
      const value = field2[2];
      if (label2 === "dated") dateFact(facts, "documentDate", value, source);
      if (kind === "invoice") {
        const textKey = lookup(invoiceFields, label2);
        const amountKey = lookup(invoiceAmounts, label2);
        if (textKey) textFact(facts, textKey, value, source);
        if (amountKey) amountFact(facts, amountKey, value, source);
        if (label2 === "pay to") invoicePayTo(facts, value, source);
      } else if (kind === "bankStatement") {
        const key = lookup(statementFields, label2);
        if (key) textFact(facts, key, value, source);
      } else {
        const key = lookup(companyFields, label2);
        if (key) textFact(facts, key, value, source);
        if (label2 === "incorporated") dateFact(facts, "incorporationDate", value, source);
        if (label2 === "status" && /^dissolved on /i.test(value)) {
          dateFact(facts, "dissolutionDate", value.slice("dissolved on ".length), source);
        }
      }
    } else if (kind === "bankStatement") {
      const movement = /^([^:]+):\s+(.+)$/.exec(line);
      if (!movement) continue;
      const date = parseDate(movement[1]);
      const amount = movementAmount.exec(movement[2]);
      if (!date || !amount) continue;
      const movementFacts = [];
      textFact(movementFacts, "movementDate", date, source);
      amountFact(movementFacts, "amount", amount[1], source);
      textFact(movementFacts, "movementDetails", movement[2], source);
      entries.push({ kind: "statementMovement", facts: movementFacts });
    }
  }
  return { kind, facts, entries };
}

// src/evidence.ts
function isMetadata(value) {
  if (typeof value !== "object" || value === null) return false;
  const row = value;
  return ["doc_id", "customer_id", "type", "title", "dated", "file"].every((key) => {
    const field2 = row[key];
    return typeof field2 === "string" && field2.trim().length > 0;
  });
}
function within(base, file) {
  const rel = relative(base, file);
  return rel !== "" && rel !== ".." && !rel.startsWith(`..${sep}`) && !isAbsolute(rel);
}
function loadEvidenceIndex(institutionDir) {
  const root = realpathSync(institutionDir);
  const indexFile = realpathSync(resolve(root, "evidence.jsonl"));
  if (!within(root, indexFile)) throw new Error("evidence.jsonl resolves outside the institution directory");
  const evidenceDir = resolve(root, "evidence");
  const rows = /* @__PURE__ */ new Map();
  const customers = /* @__PURE__ */ new Map();
  const cache = /* @__PURE__ */ new Map();
  for (const [i, line] of readFileSync(indexFile, "utf8").split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    const location = `${indexFile}:${i + 1}`;
    let row;
    try {
      row = JSON.parse(line);
    } catch (error) {
      throw new Error(`${location}: invalid JSON`, { cause: error });
    }
    if (!isMetadata(row)) throw new Error(`${location}: invalid evidence metadata`);
    if (rows.has(row.doc_id)) throw new Error(`${location}: duplicate evidence ID ${row.doc_id}`);
    if (isAbsolute(row.file) || !row.file.endsWith(".md") || !within(evidenceDir, resolve(root, row.file))) {
      throw new Error(`${location}: expected a relative Markdown path under evidence/ for ${row.doc_id}`);
    }
    rows.set(row.doc_id, row);
    const documents = customers.get(row.customer_id) ?? [];
    documents.push(row);
    customers.set(row.customer_id, documents);
  }
  function load(row) {
    const existing = cache.get(row.doc_id);
    if (existing) return existing;
    let markdown;
    try {
      const file = realpathSync(resolve(root, row.file));
      if (!within(evidenceDir, file)) throw new Error("document resolves outside the evidence directory");
      markdown = readFileSync(file, "utf8");
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      throw new Error(`Cannot read evidence ${row.doc_id} (${row.file}): ${message}`, { cause: error });
    }
    const document = { metadata: row, markdown, extraction: extractEvidence(row.doc_id, row.type, markdown) };
    cache.set(row.doc_id, document);
    return document;
  }
  return {
    metadataForCustomer: (customerId) => [...customers.get(customerId) ?? []],
    get: (docId) => {
      const row = rows.get(docId);
      return row && load(row);
    },
    documentsForCustomer: (customerId) => (customers.get(customerId) ?? []).map(load)
  };
}

// src/bank-cases.ts
var institutions = ["bank", "emoney", "investment", "payments_fx"];
var isRow = (value) => typeof value === "object" && value !== null && !Array.isArray(value);
var text = (value) => typeof value === "string" && value.trim().length > 0;
var ids = (value) => Array.isArray(value) && value.every(text) && new Set(value).size === value.length;
var nullableText = (value) => value === null || text(value);
function isDay(value) {
  if (typeof value !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
  const date = /* @__PURE__ */ new Date(`${value}T00:00:00Z`);
  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
}
function bankCase(row) {
  const w = row.review_window;
  return text(row.case_id) && text(row.customer_id) && institutions.some((value) => value === row.institution) && ids(row.alert_ids) && (row.held_payment_id === void 0 || nullableText(row.held_payment_id)) && isRow(w) && isDay(w.from) && isDay(w.to) && w.from <= w.to;
}
function bankAlert(row) {
  return text(row.alert_id) && text(row.case_id) && text(row.customer_id) && text(row.rule_id) && ids(row.transaction_ids);
}
function bankTransaction(row) {
  return text(row.transaction_id) && text(row.customer_id) && text(row.booked_at) && isDay(row.booked_at.slice(0, 10)) && Number.isFinite(Date.parse(row.booked_at)) && (row.direction === "in" || row.direction === "out") && typeof row.amount_gbp === "number" && Number.isFinite(row.amount_gbp) && row.amount_gbp >= 0 && nullableText(row.counterparty_name) && nullableText(row.counterparty_account);
}
function bankCustomer(row) {
  return text(row.customer_id) && text(row.name);
}
function indexRows(path, valid, idKey) {
  const result = /* @__PURE__ */ new Map();
  for (const [i, line] of readFileSync2(path, "utf8").split(/\r?\n/).entries()) {
    if (!line.trim()) continue;
    let row;
    try {
      row = JSON.parse(line);
    } catch (cause) {
      throw new Error(`${path}:${i + 1}: invalid JSON`, { cause });
    }
    if (!isRow(row) || !valid(row)) throw new Error(`${path}:${i + 1}: invalid row`);
    const id = row[idKey];
    if (result.has(id)) throw new Error(`${path}:${i + 1}: duplicate ID ${String(id)}`);
    result.set(id, row);
  }
  return result;
}
function listEntry(row) {
  return text(row.entry_id) && text(row.name);
}
function previousReview(row) {
  return text(row.review_id) && text(row.customer_id) && typeof row.note === "string";
}
function groupByCustomer(rows) {
  const groups = /* @__PURE__ */ new Map();
  for (const row of rows) {
    const group = groups.get(row.customer_id);
    if (group) group.push(row);
    else groups.set(row.customer_id, [row]);
  }
  return groups;
}
function loadCases(directory, bankDiagnostic) {
  const root = realpathSync2(directory);
  function input(name) {
    const path = realpathSync2(join(root, name));
    const sub = relative2(root, path);
    if (!sub || sub === ".." || sub.startsWith(`..${sep2}`) || isAbsolute2(sub)) {
      throw new Error(`${name} resolves outside the institution directory`);
    }
    return path;
  }
  const cases = indexRows(input("cases.jsonl"), bankCase, "case_id");
  const alerts = indexRows(input("alerts.jsonl"), bankAlert, "alert_id");
  const transactions = indexRows(input("transactions.jsonl"), bankTransaction, "transaction_id");
  const customers = indexRows(input("customers.jsonl"), bankCustomer, "customer_id");
  const evidence = loadEvidenceIndex(root);
  const caseInstitutions = new Set([...cases.values()].map((record3) => record3.institution));
  if (caseInstitutions.size > 1 || bankDiagnostic && [...caseInstitutions].some((value) => value !== "bank")) {
    throw new Error(bankDiagnostic ? "Expected Bank case records" : "Input folder mixes institutions");
  }
  const txByCustomer = groupByCustomer(transactions.values());
  const internalList = bankDiagnostic ? [] : [...indexRows(input("internal_list.jsonl"), listEntry, "entry_id").values()];
  const reviewsByCustomer = groupByCustomer(bankDiagnostic ? [] : indexRows(input("previous_reviews.jsonl"), previousReview, "review_id").values());
  function get(caseId) {
    const caseRecord = cases.get(caseId);
    if (!caseRecord) throw new Error(`Unknown Bank case ${caseId}`);
    const customer = customers.get(caseRecord.customer_id);
    if (!customer) throw new Error(`${caseId}: missing customer ${caseRecord.customer_id}`);
    const flagged = /* @__PURE__ */ new Map();
    const caseAlerts = caseRecord.alert_ids.map((id) => {
      const alert = alerts.get(id);
      if (!alert || alert.case_id !== caseId || alert.customer_id !== customer.customer_id) {
        throw new Error(`${caseId}: missing or unrelated alert ${id}`);
      }
      for (const transactionId of alert.transaction_ids) {
        const tx = transactions.get(transactionId);
        if (!tx || tx.customer_id !== customer.customer_id) {
          throw new Error(`${caseId}: alert ${id} refers to missing or unrelated transaction ${transactionId}`);
        }
        flagged.set(transactionId, tx);
      }
      return alert;
    });
    const heldPayment = caseRecord.held_payment_id ? transactions.get(caseRecord.held_payment_id) : void 0;
    if (caseRecord.held_payment_id && (!heldPayment || heldPayment.customer_id !== customer.customer_id || heldPayment.direction !== "out")) {
      throw new Error(`${caseId}: missing or unrelated held payment ${caseRecord.held_payment_id}`);
    }
    const { from, to } = caseRecord.review_window;
    const priorTransactions = [];
    const windowTransactions = [];
    for (const tx of txByCustomer.get(customer.customer_id) ?? []) {
      const day = tx.booked_at.slice(0, 10);
      if (day < from) priorTransactions.push(tx);
      else if (day <= to) windowTransactions.push(tx);
    }
    return {
      caseRecord,
      customer,
      alerts: caseAlerts,
      flaggedTransactions: [...flagged.values()],
      documents: evidence.documentsForCustomer(customer.customer_id),
      windowTransactions,
      priorTransactions,
      heldPayment,
      previousReviews: reviewsByCustomer.get(customer.customer_id) ?? [],
      internalList
    };
  }
  return { root, caseIds: [...cases.keys()], get };
}
function loadInstitutionCases(directory) {
  return loadCases(directory, false);
}

// src/list-assessment.ts
function record(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value : void 0;
}
function normalizedName(value) {
  return value.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\bpublic\s+limited\s+company\b/g, "plc").replace(/\blimited\b/g, "ltd").replace(/[^a-z0-9]/g, "");
}
function monthYear(value) {
  if (typeof value !== "string") return;
  const text2 = value.trim();
  let match = /^(\d{4})-(\d{2})(?:-\d{2})?$/.exec(text2);
  if (match && Number(match[2]) >= 1 && Number(match[2]) <= 12) return `${match[1]}-${match[2]}`;
  match = /^(?:\d{1,2}\s+)?([A-Za-z]+)\s+(\d{4})$/.exec(text2);
  if (!match) return;
  const months2 = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"];
  const index = months2.indexOf(match[1].toLowerCase());
  return index < 0 ? void 0 : `${match[2]}-${String(index + 1).padStart(2, "0")}`;
}
function textFacts(facts, field2) {
  return facts.filter((fact) => fact.field === field2 && typeof fact.value === "string").map((fact) => fact.value);
}
function factIn(entry, field2) {
  return textFacts(entry.facts, field2);
}
function roleDates(entry) {
  const officer = entry.kind === "companyOfficer";
  return {
    starts: factIn(entry, officer ? "appointedDate" : "notifiedDate"),
    ends: factIn(entry, officer ? "resignedDate" : "ceasedDate")
  };
}
function hasActiveRole(entry, doc, paymentDate) {
  const { starts, ends } = roleDates(entry);
  if (starts.length > 1 || ends.length > 1) return false;
  const start = starts[0] ?? doc.metadata.dated;
  return start <= paymentDate && (ends[0] ? paymentDate < ends[0] : paymentDate <= doc.metadata.dated);
}
function companyName(doc) {
  const extracted = textFacts(doc.extraction.facts, "company").find((value) => value.trim());
  if (extracted) return extracted;
  const title = doc.metadata.title.trim();
  const fromTitle = /^(?:company register extract for|register of people with significant control for)\s+(.+?)\s*$/i.exec(title);
  return fromTitle?.[1].replace(/:\s*(?:officers|directors)\s*$/i, "").trim();
}
function relevantRegister(doc, counterparties) {
  if (doc.extraction.kind !== "companyRegister") return false;
  const name = companyName(doc);
  return !!name && counterparties.has(normalizedName(name));
}
function identifierValue(value) {
  if (typeof value !== "string" && typeof value !== "number") return;
  const normalized = String(value).toUpperCase().replace(/[^A-Z0-9]/g, "");
  return normalized || void 0;
}
function companyIdentifierKeys(entry) {
  const identifiers = record(entry.identifiers);
  if (!identifiers) return [];
  return Object.keys(identifiers).filter((key) => {
    const normalizedKey = key.toLowerCase().replace(/[^a-z]/g, "");
    return ["companynumber", "companyregistrationnumber", "registrationnumber"].includes(normalizedKey);
  });
}
function hasCompanyIdentifierMatch(entry, doc) {
  const identifiers = record(entry.identifiers);
  if (!identifiers) return false;
  const companyNumber = textFacts(doc.extraction.facts, "companyNumber");
  if (!companyNumber.length) return false;
  for (const [key, value] of Object.entries(identifiers)) {
    const normalizedKey = key.toLowerCase().replace(/[^a-z]/g, "");
    if (!["companynumber", "companyregistrationnumber", "registrationnumber"].includes(normalizedKey)) continue;
    const listed = identifierValue(value);
    if (listed && companyNumber.some((number) => identifierValue(number) === listed)) return true;
  }
  return false;
}
function assessListMatch(alert, entries, documents, transactions) {
  const measured = record(alert.measured);
  const selectedId = measured?.list_entry;
  if (typeof selectedId !== "string" || !selectedId.trim()) {
    return { status: "unresolved", evidence: [], detail: "The alert does not identify a usable measured.list_entry, so no list entry can be assessed." };
  }
  const listed = entries.find((entry) => entry.entry_id === selectedId);
  if (!listed) {
    return { status: "unresolved", evidence: [], detail: `The alert selects list entry ${selectedId}, but that entry is not present in the supplied list.` };
  }
  const results = transactions.map((tx) => ({
    ...assessTransaction(listed, measured?.matched_on, documents, tx),
    transactionId: tx.transaction_id
  }));
  const confirmed = results.find((result) => result.status === "confirmed");
  if (confirmed) return confirmed;
  if (results.length && results.every((result) => result.status === "different")) {
    return { ...results[0], evidence: [...new Set(results.flatMap((result) => result.evidence))] };
  }
  return results.find((result) => result.status === "unresolved") ?? {
    status: "unresolved",
    evidence: [listed.entry_id],
    detail: `The selected list entry is ${listed.name}, but no flagged transaction is available to assess.`
  };
}
function assessTransaction(listed, matchedOn, documents, tx) {
  const baseEvidence = [listed.entry_id];
  const paymentDate = tx.booked_at.slice(0, 10);
  const counterpartySet = new Set(tx.counterparty_name ? [normalizedName(tx.counterparty_name)] : []);
  const registers = documents.filter((doc) => relevantRegister(doc, counterpartySet));
  if (companyIdentifierKeys(listed).length > 0) {
    const matchingDocs = registers.filter((doc) => hasCompanyIdentifierMatch(listed, doc));
    if (matchingDocs.length === 1) {
      const doc = matchingDocs[0];
      return {
        status: "confirmed",
        evidence: [...baseEvidence, doc.metadata.doc_id],
        detail: `The alert-selected entry ${listed.name} is corroborated by the same unique company number in the parsed register for the named counterparty; this is more than a name or premises match.`
      };
    }
    if (matchingDocs.length > 1) {
      return { status: "unresolved", evidence: baseEvidence, detail: `More than one parsed register document appears to match the unique company identifier for ${listed.name}, so the business identity is not resolved.` };
    }
    const inspectedDocs = registers.map((doc) => doc.metadata.doc_id);
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...inspectedDocs],
      detail: `The selected entry ${listed.name} supplies a company identifier, but the parsed register evidence does not verify that identifier for a named counterparty; a name or premises resemblance alone is not conclusive.`
    };
  }
  const listedName = normalizedName(listed.name);
  const listedBirth = monthYear(listed.date_of_birth);
  const relevantRows = [];
  for (const doc of registers) {
    for (const row of doc.extraction.entries) {
      if (row.kind !== "companyOfficer" && row.kind !== "significantControl") continue;
      const person = factIn(row, "person").find((value) => normalizedName(value) === listedName);
      if (!person) continue;
      const born = factIn(row, "birthDetail");
      relevantRows.push({ doc, entry: row, person, born, active: hasActiveRole(row, doc, paymentDate) });
    }
  }
  const identityRows = relevantRows.filter((row) => row.active && row.born.length > 0);
  const corroborating = identityRows.filter((row) => {
    const registerBirth = row.born.map(monthYear).filter((value) => !!value);
    return listedBirth !== void 0 && registerBirth.includes(listedBirth);
  });
  const conflicting = identityRows.filter((row) => {
    const registerBirth = row.born.map(monthYear).filter((value) => !!value);
    return listedBirth !== void 0 && registerBirth.length > 0 && registerBirth.every((value) => value !== listedBirth);
  });
  if (corroborating.length > 0 && conflicting.length > 0) {
    return {
      status: "unresolved",
      evidence: baseEvidence,
      detail: `Parsed registers for the counterparty give conflicting month-and-year-of-birth evidence for ${listed.name}; the identity cannot safely be resolved.`
    };
  }
  if (corroborating.length > 0) {
    const { doc, entry } = corroborating.find((row) => row.entry.kind === "significantControl") ?? corroborating[0];
    const { ends } = roleDates(entry);
    const role = entry.kind === "significantControl" ? "significant control" : "an active officer role";
    const until = ends[0] ? ` (ending on ${ends[0]})` : "";
    return {
      status: "confirmed",
      evidence: [...baseEvidence, doc.metadata.doc_id],
      detail: `Register ${doc.metadata.doc_id} matches ${listed.name}'s birth month and year to list entry ${listed.entry_id} and shows ${role} on the transaction date ${paymentDate}${until}`
    };
  }
  if (conflicting.length > 0) {
    const docs = [...new Set(conflicting.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "different",
      evidence: [...baseEvidence, ...docs],
      detail: `The parsed register for the named counterparty records an active role or significant control for ${listed.name}, but its month and year of birth conflicts with the selected list entry; the shared name is therefore not enough to identify the listed person.`
    };
  }
  const listedUnit = typeof listed.address === "string" ? /^unit\s+([a-z0-9-]+)\s*,?\s+(.+)/i.exec(listed.address.trim()) : null;
  if (typeof matchedOn === "string" && /^registered address\b/i.test(matchedOn) && listedUnit && !relevantRows.length) {
    for (const doc of registers) {
      const office = textFacts(doc.extraction.facts, "registeredOffice");
      if (office.length !== 1) continue;
      const unit = /^unit\s+([a-z0-9-]+)\s*,?\s+(.+)/i.exec(office[0]);
      if (!unit || unit[1].toLowerCase() === listedUnit[1].toLowerCase() || normalizedName(unit[2]) !== normalizedName(listedUnit[2])) continue;
      const controllingOwner = doc.extraction.entries.find((row) => row.kind === "significantControl" && hasActiveRole(row, doc, paymentDate) && factIn(row, "person").some((name) => normalizedName(name) !== listedName) && factIn(row, "control").some((description) => /\b75% or more of (?:the )?shares\b/i.test(description)));
      if (!controllingOwner) continue;
      const controller = factIn(controllingOwner, "person")[0];
      return {
        status: "different",
        evidence: [...baseEvidence, doc.metadata.doc_id],
        detail: `Register ${doc.metadata.doc_id} locates ${companyName(doc)} at Unit ${unit[1]}, not the listed Unit ${listedUnit[1]}, and records ${controller} as holding at least 75% of its shares`
      };
    }
  }
  if (relevantRows.length > 0 && !listedBirth) {
    const docs = [...new Set(relevantRows.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...docs],
      detail: `A parsed register for the named counterparty contains ${listed.name}, but the selected list entry has no usable date of birth for comparison; name and role alone do not establish identity.`
    };
  }
  if (relevantRows.length > 0) {
    const docs = [...new Set(relevantRows.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...docs],
      detail: `A parsed register for the named counterparty contains ${listed.name}, but it does not establish a matching birth month and year in a role or control record active on ${paymentDate}; the list match remains undecided.`
    };
  }
  return {
    status: "unresolved",
    evidence: baseEvidence,
    detail: `The selected list entry is ${listed.name}. The supplied parsed register evidence does not independently link that identity to a named counterparty, and a name or premises match alone is not conclusive.`
  };
}

// src/reconciliation.ts
var normalize = (s) => s.trim().replace(/\s+/g, " ").toLowerCase();
function minor(amount) {
  const parts = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(amount));
  const minor2 = parts && Number(parts[1] + (parts[2] ?? "").padEnd(2, "0"));
  return typeof minor2 === "number" && Number.isSafeInteger(minor2) ? minor2 : void 0;
}
var compactAccount = (s) => s.replace(/^account\s+/i, "").replace(/[ -]/g, "").toUpperCase();
var fullAccount = (s) => /^(?:\d{14}|[A-Z]{2}\d{2}[A-Z\d]{11,30})$/.test(s);
var shortAccount = (s) => /^(?:(?:account|iban)\s+)?ending\s+(\d{4})$/i.exec(s.trim())?.[1];
function oneText(facts, keys) {
  const values = facts.filter((f) => keys.includes(f.field) && typeof f.value === "string").map((f) => f.value);
  if (values.length === 1) return values[0];
}
function agreesWithDate(pack, doc, tx) {
  const dated = oneText(doc.extraction.facts, ["documentDate"]);
  const { from, to } = pack.caseRecord.review_window;
  const day = tx.booked_at.slice(0, 10);
  return !!dated && dated === doc.metadata.dated && from <= dated && dated <= day && day <= to;
}
function invoiceMatches(pack, doc, tx) {
  if (doc.extraction.kind !== "invoice" || doc.extraction.entries.length || tx.direction !== "out" || !tx.counterparty_name || !agreesWithDate(pack, doc, tx)) return false;
  const facts = doc.extraction.facts;
  const payer = oneText(facts, ["billedTo", "buyer"]);
  const payee = oneText(facts, ["payee"]);
  const supplier = oneText(facts, ["supplier", "carrier"]);
  const name = normalize(tx.counterparty_name);
  const country = typeof tx.counterparty_country === "string" ? normalize(tx.counterparty_country) : "";
  const samePayee = (value) => normalize(value) === name || !!country && normalize(value) === `${name}, ${country}`;
  if (!payer || normalize(payer) !== normalize(pack.customer.name) || !payee && !supplier || payee && !samePayee(payee) || supplier && !samePayee(supplier)) return false;
  const values = facts.filter((fact) => ["amountDue", "amount", "total"].includes(fact.field));
  if (values.length !== 1 || typeof values[0].value === "string" || values[0].value.minorUnits <= 0 || values[0].value.minorUnits !== minor(tx.amount_gbp)) return false;
  if (facts.some((fact) => fact.field === "terms" && typeof fact.value === "string" && /instal[l]?ment/i.test(fact.value))) return false;
  const destinations = facts.filter((fact) => fact.field === "paymentDestination");
  if (!destinations.length) return true;
  if (destinations.length !== 1 || typeof destinations[0].value !== "string" || !tx.counterparty_account) return false;
  const dest = compactAccount(destinations[0].value);
  const account = compactAccount(tx.counterparty_account);
  return fullAccount(dest) && dest === account;
}
function matchedInvoices(pack, transactions) {
  const matches = [];
  const documentCounts = /* @__PURE__ */ new Map();
  const transactionCounts = /* @__PURE__ */ new Map();
  for (const doc of pack.documents) {
    if (doc.extraction.kind !== "invoice") continue;
    for (const tx of transactions) {
      if (!invoiceMatches(pack, doc, tx)) continue;
      const id = doc.metadata.doc_id;
      matches.push({ tx: tx.transaction_id, doc: id });
      documentCounts.set(id, (documentCounts.get(id) ?? 0) + 1);
      transactionCounts.set(tx.transaction_id, (transactionCounts.get(tx.transaction_id) ?? 0) + 1);
    }
  }
  return new Map(matches.filter(({ doc, tx }) => documentCounts.get(doc) === 1 && transactionCounts.get(tx) === 1).map(({ doc, tx }) => [tx, doc]));
}
function ownedAccount(pack, tx) {
  if (!tx.counterparty_account) return;
  for (const doc of pack.documents) {
    if (doc.extraction.kind !== "bankStatement") continue;
    const accountHolder = oneText(doc.extraction.facts, ["accountHolder"]);
    if (!accountHolder || normalize(accountHolder) !== normalize(pack.customer.name)) continue;
    if (tx.counterparty_name && normalize(tx.counterparty_name) !== normalize(pack.customer.name)) continue;
    const statementAccount = oneText(doc.extraction.facts, ["account"]);
    if (!statementAccount) continue;
    const account = compactAccount(statementAccount);
    if (fullAccount(account) && account === compactAccount(tx.counterparty_account)) return doc.metadata.doc_id;
    const suffix = shortAccount(statementAccount);
    if (!suffix || suffix !== shortAccount(tx.counterparty_account)) continue;
    const linked = doc.extraction.entries.some(({ kind, facts }) => kind === "statementMovement" && oneText(facts, ["movementDate"]) === tx.booked_at.slice(0, 10) && facts.some((f) => f.field === "amount" && typeof f.value !== "string" && f.value.minorUnits === minor(tx.amount_gbp)));
    if (linked) return doc.metadata.doc_id;
  }
}

// src/documented-credits.ts
function one(items) {
  return items.length === 1 ? items[0] : void 0;
}
function field(markdown, label2) {
  return one([...markdown.matchAll(new RegExp(`^\\*\\*${label2}:\\*\\*[ \\t]*(.+)$`, "gim"))].map((match) => match[1].trim()));
}
function refMatches(text2, kind) {
  const matches = [...text2.matchAll(new RegExp(`\\b${kind}[ \\t]+(?=[A-Z0-9-]*\\d)[A-Z0-9]+(?:-[A-Z0-9]+)*\\b`, "gi"))];
  return one([...new Set(matches.map((m) => normalize(m[0])))]);
}
function oneAmount(text2) {
  const amounts = [...text2.matchAll(/£[ \t]*[\d,]+(?:\.\d+)?/g)];
  const amount = one(amounts);
  return amount && parseGbp(amount[0])?.minorUnits;
}
function terms(doc, customerName) {
  const { markdown } = doc;
  if (doc.metadata.type === "insurer_letter") {
    const issuer = /^# Claim settlement letter from (.+)$/im.exec(markdown)?.[1]?.trim();
    const salutation = /^Dear[ \t]+(.+?),[ \t]*$/im.exec(markdown)?.[1];
    const beneficiary = /\bto[ \t]+([^\n.,]+?)[ \t]+(?:via|by)[ \t]+bank transfer\b/i.exec(markdown)?.[1];
    const addressed = salutation && normalize(salutation) === normalize(customerName);
    const namedBeneficiary = beneficiary && normalize(beneficiary) === normalize(customerName);
    const reference = refMatches(markdown, "claim");
    const amount = oneAmount(markdown);
    const accepted = /\b(?:accepted your claim|your claim[^.\n]{0,100}has been accepted)\b/i.test(markdown);
    const disputed = /\b(?:not (?:yet )?accepted|declined|rejected|not approved|subject to approval|pending|provisional|partial|cannot confirm|can['’]t confirm|unable to confirm|will not pay|under review)\b/i.test(markdown);
    if (issuer && reference && amount && accepted && !disputed && (addressed || namedBeneficiary) && (!beneficiary || /^(?:you|your account)$/i.test(beneficiary) || namedBeneficiary)) {
      return { kind: "insurance_payout", party: issuer, amount, reference };
    }
  }
  if (doc.metadata.type === "venue_email") {
    const issuer = /^# Email from (.+)$/im.exec(markdown)?.[1]?.trim();
    const reference = refMatches(markdown, "booking");
    const amount = oneAmount(markdown);
    if (issuer && reference && amount && /\bcancell?ation\b|\bcancell?ed\b/i.test(markdown) && /\brefund\b/i.test(markdown) && !/\b(?:no refund|not refunded|non.refundable|not refunding|unable to refund|partial refund|refund (?:is )?(?:declined|denied|not due|not issued)|will not (?:be )?refund|forfeited|retained)\b/i.test(markdown)) {
      return { kind: "refund", party: issuer, amount, reference };
    }
  }
  if (doc.metadata.type === "credit_note") {
    const issuer = /^# Credit note from (.+)$/im.exec(markdown)?.[1]?.trim();
    const supplier = field(markdown, "Supplier");
    const customer = field(markdown, "Customer");
    const cause = field(markdown, "Credit for");
    const refund = field(markdown, "Refund");
    const reference = cause && refMatches(cause, "booking");
    const amount = refund && parseGbp(refund)?.minorUnits;
    if (issuer && supplier && (normalize(supplier) === normalize(issuer) || normalize(supplier).startsWith(`${normalize(issuer)}, `)) && customer && normalize(customer) === normalize(customerName) && cause && /\bcancell?ed\b/i.test(cause) && !/\b(?:not|never)\s+cancell?ed\b/i.test(cause) && reference && amount) {
      return { kind: "refund", party: issuer, amount, reference };
    }
  }
}
function mentions(text2, identifier) {
  const literal = normalize(identifier).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return new RegExp(`(?<![a-z0-9-])${literal}(?![a-z0-9-])`).test(normalize(text2));
}
function validDate(day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return false;
  const date = /* @__PURE__ */ new Date(`${day}T00:00:00Z`);
  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === day;
}
var txReference = (tx) => typeof tx.reference === "string" ? normalize(tx.reference) : "";
var namesParty = (tx, party) => !!tx.counterparty_name && normalize(tx.counterparty_name) === normalize(party);
function originalPayment(credit, payment, dated, history) {
  return one(history.filter((tx) => tx.direction === "out" && tx.customer_id === payment.customer_id && Date.parse(tx.booked_at) < Date.parse(payment.booked_at) && tx.booked_at.slice(0, 10) <= dated && txReference(tx) === credit.reference && minor(tx.amount_gbp) === credit.amount && namesParty(tx, credit.party) && tx.counterparty_country === payment.counterparty_country));
}
function documentedCredits(pack) {
  const candidates = pack.documents.flatMap((doc) => {
    const credit = doc.metadata.customer_id === pack.customer.customer_id ? terms(doc, pack.customer.name) : void 0;
    return credit ? [{ doc, credit }] : [];
  });
  const byDocument = new Map(candidates.map(({ doc, credit }) => [doc, credit]));
  const history = [...pack.priorTransactions, ...pack.windowTransactions].filter((tx) => tx.transaction_id !== pack.heldPayment?.transaction_id);
  const matches = [];
  for (const { doc, credit } of candidates) {
    if (!validDate(doc.metadata.dated)) continue;
    const unresolved = pack.documents.some((other) => {
      if (other === doc || other.metadata.customer_id !== pack.customer.customer_id) return false;
      if (mentions(other.markdown, doc.metadata.doc_id) && /\b(?:forged|altered|fabricat\w*|unverified|could not verify|suspicious)\b/i.test(other.markdown)) return true;
      if (!mentions(other.markdown, credit.reference)) return false;
      const terms2 = byDocument.get(other);
      return !terms2 || terms2.kind !== credit.kind || terms2.reference !== credit.reference || terms2.amount !== credit.amount || normalize(terms2.party) !== normalize(credit.party);
    });
    if (unresolved) continue;
    const reference = credit.kind === "refund" ? `refund ${credit.reference}` : credit.reference;
    const payment = one(history.filter((tx) => tx.direction === "in" && tx.customer_id === pack.customer.customer_id && txReference(tx) === reference && minor(tx.amount_gbp) === credit.amount && namesParty(tx, credit.party)));
    if (!payment) continue;
    const day = payment.booked_at.slice(0, 10);
    const { from, to } = pack.caseRecord.review_window;
    if (day < from || day > to || doc.metadata.dated > day) continue;
    const original = credit.kind === "refund" ? originalPayment(credit, payment, doc.metadata.dated, history) : void 0;
    if (credit.kind === "refund" && !original) continue;
    matches.push({ kind: credit.kind, reference: credit.reference.toUpperCase(), documentId: doc.metadata.doc_id, payment, original });
  }
  const counts = /* @__PURE__ */ new Map();
  for (const { payment } of matches) counts.set(payment.transaction_id, (counts.get(payment.transaction_id) ?? 0) + 1);
  return new Map(matches.filter(({ payment }) => counts.get(payment.transaction_id) === 1).map((match) => [match.payment.transaction_id, match]));
}

// src/decision.ts
var reasonCodes = {
  CLOSE: [
    "COLLECTION_DOCUMENTED",
    "BUSINESS_RECORDS_RECONCILE",
    "DOCUMENTED_EVENT",
    "INVOICE_MATCHES",
    "OWN_ACCOUNT",
    "GROUP_COMPANY",
    "THIRD_PARTY_DOCUMENTED",
    "REFUND_OF_EARLIER_PAYMENT",
    "RETURNING_CUSTOMER",
    "LIST_MATCH_DIFFERENT_PARTY",
    "WITHIN_PROFILE"
  ],
  RFI: ["RFI_PURPOSE_DOCUMENTS", "RFI_BUSINESS_RECORDS", "RFI_SOURCE_OF_FUNDS", "RFI_COUNTERPARTY_DETAILS", "RFI_UPDATED_PROFILE"],
  ESCALATE: [
    "ESC_MULE_ACTIVITY",
