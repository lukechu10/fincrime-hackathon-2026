// src/llm/openrouter.ts
var ENDPOINT = "https://openrouter.ai/api/v1/chat/completions";
var MODEL = "anthropic/claude-haiku-5.5";
var sleep = (ms) => new Promise((resolve3) => setTimeout(resolve3, ms));
function parseReply(content) {
  if (typeof content !== "string") return void 0;
  const text2 = content.replace(/<think>[\s\S]*?<\/think>/gi, "").trim().replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/, "");
  try {
    return JSON.parse(text2);
  } catch {
  }
  const start = text2.indexOf("{");
  const end = text2.lastIndexOf("}");
  if (start < 0 || end <= start) return void 0;
  try {
    return JSON.parse(text2.slice(start, end + 1));
  } catch {
    return void 0;
  }
}
function openRouterReader(options) {
  const { apiKey, model = MODEL, budgetMs = 20 * 6e4, timeoutMs = 45e3, attempts = 3, fetchImpl = fetch } = options;
  const deadline = Date.now() + budgetMs;
  let calls = 0, failures = 0, skipped = 0, promptTokens = 0, completionTokens = 0, cost = 0;
  async function read(kind, doc, customerName) {
    if (Date.now() > deadline) {
      skipped++;
      return void 0;
    }
    const { name, schema } = SCHEMAS[kind];
    const body = JSON.stringify({
      model,
      messages: messages(kind, doc, customerName),
      response_format: { type: "json_schema", json_schema: { name, strict: true, schema } },
      // Ignored by models that do not support them; the answer is validated against the document either way.
      temperature: 0,
      seed: 0,
      max_tokens: 4e3,
      ...model.startsWith("anthropic/") ? { provider: { order: ["anthropic"] } } : {},
      usage: { include: true }
    });
    for (let attempt = 1; attempt <= attempts; attempt++) {
      calls++;
      try {
        const response = await fetchImpl(ENDPOINT, {
          method: "POST",
          body,
          signal: AbortSignal.timeout(timeoutMs),
          headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" }
        });
        if (response.status === 429 || response.status >= 500) {
          if (response.status === 429 && attempt < attempts) await sleep(1e4 * attempt);
          throw new Error(`HTTP ${response.status}`);
        }
        if (!response.ok) {
          failures++;
          warn(`model call for ${doc.metadata.doc_id} failed with HTTP ${response.status}`);
          return void 0;
        }
        const json = await response.json();
        promptTokens += json.usage?.prompt_tokens ?? 0;
        completionTokens += json.usage?.completion_tokens ?? 0;
        cost += json.usage?.cost ?? 0;
        const parsed = parseReply(json.choices?.[0]?.message?.content);
        if (parsed === void 0) failures++;
        return parsed;
      } catch (error) {
        if (attempt === attempts || Date.now() > deadline) {
          failures++;
          warn(`model call for ${doc.metadata.doc_id} failed: ${error instanceof Error ? error.message : String(error)}`);
          return void 0;
        }
        await sleep(2e3 * attempt);
      }
    }
    return void 0;
  }
  return {
    read,
    summary: () => `model ${model}: ${calls} calls, ${failures} without a usable answer, ${skipped} skipped after the time budget, ${promptTokens} prompt and ${completionTokens} completion tokens, US$${cost.toFixed(4)}`
  };
}

// src/submission.ts
function verify(pack, result) {
  const { case_id, alert_ids } = pack.caseRecord;
  if (result.case_id !== case_id || result.alert_ids.length !== alert_ids.length || alert_ids.some((id, i) => result.alert_ids[i] !== id)) {
    throw new Error(`${case_id}: incorrect case or alert coverage`);
  }
  const allowedCodes = reasonCodes[result.verdict];
  if (!allowedCodes?.includes(result.reason_code) || !result.reason.trim()) {
    throw new Error(`${case_id}: invalid verdict, reason code, or explanation`);
  }
  const validEvidence2 = /* @__PURE__ */ new Set([
    ...pack.flaggedTransactions.map((row) => row.transaction_id),
    ...pack.windowTransactions.map((row) => row.transaction_id),
    ...pack.priorTransactions.map((row) => row.transaction_id),
    ...pack.heldPayment ? [pack.heldPayment.transaction_id] : [],
    ...pack.documents.map((doc) => doc.metadata.doc_id),
    ...pack.internalList.map((row) => row.entry_id)
  ]);
  if (new Set(result.evidence).size !== result.evidence.length || result.evidence.some((id) => !validEvidence2.has(id))) {
    throw new Error(`${case_id}: invalid evidence reference`);
  }
}
function fallbackDecision(stub) {
  return {
    case_id: stub.case_id,
    alert_ids: [...stub.alert_ids],
    verdict: "ESCALATE",
    reason_code: "ESC_UNEXPLAINED_FUNDS",
    reason: "The automated review could not assess this case because some of its input records could not be read or checked. Without them the flagged activity is not shown to be explained, so refer the case to the MLRO for manual review without contacting the customer.",
    evidence: []
  };
}
var inside = (base, path) => {
  const sub = relative3(base, path);
  return !sub || sub !== ".." && !sub.startsWith(`..${sep3}`) && !isAbsolute3(sub);
};
function defaultReader() {
  const apiKey = process.env.OPENROUTER_API_KEY?.trim();
  const model = process.env.OPENROUTER_MODEL?.trim() || void 0;
  return apiKey ? openRouterReader({ apiKey, model }) : void 0;
}
async function runSubmission(input, output, options = {}) {
  const target = resolve2(output);
  const inputRoot = realpathSync3(input);
  const refuse = () => new Error("Output must not overwrite or be placed inside the supplied institution directory");
  if (inside(resolve2(input), target) || inside(inputRoot, target)) throw refuse();
  mkdirSync(dirname(target), { recursive: true });
  const canonical = join2(realpathSync3(dirname(target)), basename(target));
  if (inside(inputRoot, canonical)) throw refuse();
  const existing = lstatSync(canonical, { throwIfNoEntry: false });
  if (existing && (!existing.isFile() || existing.nlink > 1)) {
    throw new Error("Output path must be a regular, unshared file");
  }
  const cases = loadInstitutionCases(inputRoot);
  const results = [];
  const open = [];
  const reader = options.reader === void 0 ? defaultReader() : options.reader ?? void 0;
  let fallbacks = 0;
  for (const id of cases.caseIds) {
    let result;
    try {
      const pack = cases.get(id);
      result = decideCase(pack);
      verify(pack, result);
      const tasks = reader ? planTasks(pack, result) : [];
      if (tasks.length) open.push({ index: results.length, pack, tasks });
    } catch (error) {
      warn(`${error instanceof Error ? error.message : String(error)}; escalating ${id}`);
      result = fallbackDecision(cases.stub(id) ?? { case_id: id, alert_ids: [] });
      fallbacks++;
    }
    results.push(result);
  }
  if (fallbacks) warn(`${fallbacks} of ${results.length} cases could not be assessed and were escalated`);
  if (reader && open.length) {
    const answers = await readAll(open.flatMap(({ pack, tasks }) => tasks.map((task) => ({ task, customerName: pack.customer.name }))), reader);
    let changed = 0;
    for (const { index, pack, tasks } of open) {
      try {
        const findings = findingsFor(pack, tasks, answers);
        if (!findings.explanations.length && !findings.signals.length) continue;
        const revised = decideCase(pack, findings);
        verify(pack, revised);
        if (revised.verdict !== results[index].verdict || revised.reason_code !== results[index].reason_code) changed++;
        results[index] = revised;
      } catch (error) {
        warn(`${pack.caseRecord.case_id}: fallback findings not used (${error instanceof Error ? error.message : String(error)})`);
      }
    }
    warn(`fallback reader: ${open.length} cases had unread documents; ${changed} changed verdict or reason code; ${reader.summary()}`);
  }
  const lines = results.map((result) => JSON.stringify(result));
  writeFileSync(canonical, lines.length ? `${lines.join("\n")}
` : "", "utf8");
}

// src/index.ts
var arguments_ = process.argv.slice(2);
if (arguments_.length === 1 && ["--help", "-h"].includes(arguments_[0])) {
  console.log("Usage: system/run <institution-folder> <output-file>");
} else if (arguments_.length !== 2 || arguments_.some((arg) => !arg.trim())) {
  console.error("Usage: system/run <institution-folder> <output-file>");
  process.exitCode = 2;
} else {
  runSubmission(arguments_[0], arguments_[1]).catch((error) => {
    console.error(`run: ${error instanceof Error ? error.message : String(error)}`);
    process.exitCode = 1;
  });
}
