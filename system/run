function establishedPayees(ctx, add) {
  const { from } = ctx.pack.caseRecord.review_window;
  for (const tx of outgoing(ctx)) {
    if (!tx.counterparty_name || !tx.counterparty_account || sameName(tx.counterparty_name, ctx.name) || HIGHER_RISK_COUNTRIES.has(norm(String(tx.counterparty_country ?? "")))) continue;
    const earlier = ctx.history.filter((h) => h.direction === "out" && txDay(h) < from && sameName(h.counterparty_name, tx.counterparty_name) && sameAccount(h.counterparty_account, tx.counterparty_account));
    if (earlier.length >= 2) {
      add(tx, {
        code: "WITHIN_PROFILE",
        docs: [],
        related: [],
        fact: `${describe(tx)} is to an established payee paid ${earlier.length} times before the review window`
      });
    }
  }
}
function clientFunding(ctx, add, explained, gaps) {
  if (ctx.pack.caseRecord.institution !== "payments_fx") return;
  for (const tx of incoming(ctx)) {
    if (!sameName(tx.counterparty_name, ctx.name) || explained.has(tx.transaction_id)) continue;
    if (!tx.counterparty_account) {
      add(tx, { code: "WITHIN_PROFILE", docs: [], related: [], ownFunds: true, fact: `${describe(tx)} is routine funding from ${label(ctx.name)}'s own bank` });
      continue;
    }
    const onward = ctx.history.find((out) => out.direction === "out" && out.booked_at > tx.booked_at && daysBetween(txDay(tx), txDay(out)) <= 3 && out.amount_gbp <= tx.amount_gbp && out.amount_gbp >= 0.9 * tx.amount_gbp);
    const reason = onward && explained.get(onward.transaction_id);
    if (onward && reason && reason.code !== "WITHIN_PROFILE") {
      add(tx, {
        code: reason.code,
        docs: reason.docs,
        related: [onward.transaction_id, ...reason.related],
        fact: `${describe(tx)} funded the onward payment of ${describe(onward)}; ${reason.fact}`
      });
    } else if (onward) {
      gaps.set(tx.transaction_id, onward);
    }
  }
}
function explainTransactions(pack, extra = []) {
  const ctx = context(pack);
  const byTx = /* @__PURE__ */ new Map();
  const add = (tx, explanation) => {
    if (!byTx.has(tx.transaction_id)) byTx.set(tx.transaction_id, explanation);
  };
  ownAccount(ctx, add);
  const invoicePayeeConflicts = invoices(ctx, add);
  for (const explain of [
    credits,
    cancellations,
    settlementLetters,
    solicitorLetters,
    completionStatements,
    giftLetters,
    saleReceipts,
    takingsBooks,
    collectionReports,
    cashReconciliations,
    bookingConfirmations,
    tenancyDeposits,
    vehicleFinance,
    hospitalInvoices,
    redundancy,
    cashRedeposits,
    contractSchedules,
    contractorFiles,
    freightInvoices,
    groupCompanies,
    invoiceFinance,
    payroll,
    heldPaymentReceipt,
    establishedPayees
  ]) {
    explain(ctx, add);
  }
  for (const { tx, explanation } of extra) add(tx, explanation);
  const unexplainedOnward = /* @__PURE__ */ new Map();
  clientFunding(ctx, add, byTx, unexplainedOnward);
  return { byTx, invoicePayeeConflicts, unexplainedOnward };
}

// src/list-assessment.ts
function record(value) {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value : void 0;
}
function normalizedName(value) {
  return value.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\bpublic\s+limited\s+company\b/g, "plc").replace(/\blimited\b/g, "ltd").replace(/[^a-z0-9]/g, "");
}
function monthYear(value) {
  if (typeof value !== "string") return;
  const text2 = value.trim();
  let match = /^(\d{4})-(\d{2})(?:-\d{2})?$/.exec(text2);
  if (match && Number(match[2]) >= 1 && Number(match[2]) <= 12) return `${match[1]}-${match[2]}`;
  match = /^(?:\d{1,2}\s+)?([A-Za-z]+)\s+(\d{4})$/.exec(text2);
  if (!match) return;
  const months2 = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"];
  const index = months2.indexOf(match[1].toLowerCase());
  return index < 0 ? void 0 : `${match[2]}-${String(index + 1).padStart(2, "0")}`;
}
function textFacts(facts, field3) {
  return facts.filter((fact) => fact.field === field3 && typeof fact.value === "string").map((fact) => fact.value);
}
function factIn(entry, field3) {
  return textFacts(entry.facts, field3);
}
function roleDates(entry) {
  const officer = entry.kind === "companyOfficer";
  return {
    starts: factIn(entry, officer ? "appointedDate" : "notifiedDate"),
    ends: factIn(entry, officer ? "resignedDate" : "ceasedDate")
  };
}
function hasActiveRole(entry, doc, paymentDate) {
  const { starts, ends } = roleDates(entry);
  if (starts.length > 1 || ends.length > 1) return false;
  const start = starts[0] ?? doc.metadata.dated;
  return start <= paymentDate && (!ends[0] || paymentDate < ends[0]);
}
function companyName(doc) {
  const extracted = textFacts(doc.extraction.facts, "company").find((value) => value.trim());
  if (extracted) return extracted;
  const title2 = doc.metadata.title.trim();
  const fromTitle2 = /^(?:company register extract for|register of people with significant control for)\s+(.+?)\s*$/i.exec(title2);
  return fromTitle2?.[1].replace(/:\s*(?:officers|directors)\s*$/i, "").trim();
}
function relevantRegister(doc, counterparties) {
  if (doc.extraction.kind !== "companyRegister") return false;
  const name = companyName(doc);
  return !!name && counterparties.has(normalizedName(name));
}
function identifierValue(value) {
  if (typeof value !== "string" && typeof value !== "number") return;
  const normalized = String(value).toUpperCase().replace(/[^A-Z0-9]/g, "");
  return normalized || void 0;
}
function companyIdentifierKeys(entry) {
  const identifiers = record(entry.identifiers);
  if (!identifiers) return [];
  return Object.keys(identifiers).filter((key) => {
    const normalizedKey = key.toLowerCase().replace(/[^a-z]/g, "");
    return ["companynumber", "companyregistrationnumber", "registrationnumber"].includes(normalizedKey);
  });
}
function hasCompanyIdentifierMatch(entry, doc) {
  const identifiers = record(entry.identifiers);
  if (!identifiers) return false;
  const companyNumber = textFacts(doc.extraction.facts, "companyNumber");
  if (!companyNumber.length) return false;
  for (const [key, value] of Object.entries(identifiers)) {
    const normalizedKey = key.toLowerCase().replace(/[^a-z]/g, "");
    if (!["companynumber", "companyregistrationnumber", "registrationnumber"].includes(normalizedKey)) continue;
    const listed = identifierValue(value);
    if (listed && companyNumber.some((number) => identifierValue(number) === listed)) return true;
  }
  return false;
}
function assessListMatch(alert, entries, documents, transactions) {
  const measured = record(alert.measured);
  const selectedId = measured?.list_entry;
  if (typeof selectedId !== "string" || !selectedId.trim()) {
    return { status: "unresolved", evidence: [], detail: "The alert does not identify a usable measured.list_entry, so no list entry can be assessed." };
  }
  const listed = entries.find((entry) => entry.entry_id === selectedId);
  if (!listed) {
    return { status: "unresolved", evidence: [], detail: `The alert selects list entry ${selectedId}, but that entry is not present in the supplied list.` };
  }
  const results = transactions.map((tx) => ({
    ...assessTransaction(listed, measured?.matched_on, documents, tx),
    transactionId: tx.transaction_id
  }));
  const confirmed = results.find((result) => result.status === "confirmed");
  if (confirmed) return confirmed;
  if (results.length && results.every((result) => result.status === "different")) {
    return { ...results[0], evidence: [...new Set(results.flatMap((result) => result.evidence))] };
  }
  return results.find((result) => result.status === "unresolved") ?? {
    status: "unresolved",
    evidence: [listed.entry_id],
    detail: `The selected list entry is ${listed.name}, but no flagged transaction is available to assess.`
  };
}
function assessTransaction(listed, matchedOn, documents, tx) {
  const baseEvidence = [listed.entry_id];
  const paymentDate = tx.booked_at.slice(0, 10);
  const counterpartySet = new Set(tx.counterparty_name ? [normalizedName(tx.counterparty_name)] : []);
  const registers = documents.filter((doc) => relevantRegister(doc, counterpartySet));
  if (companyIdentifierKeys(listed).length > 0) {
    const matchingDocs = registers.filter((doc) => hasCompanyIdentifierMatch(listed, doc));
    if (matchingDocs.length === 1) {
      const doc = matchingDocs[0];
      return {
        status: "confirmed",
        evidence: [...baseEvidence, doc.metadata.doc_id],
        detail: `The alert-selected entry ${listed.name} is corroborated by the same unique company number in the parsed register for the named counterparty; this is more than a name or premises match.`
      };
    }
    if (matchingDocs.length > 1) {
      return { status: "unresolved", evidence: baseEvidence, detail: `More than one parsed register document appears to match the unique company identifier for ${listed.name}, so the business identity is not resolved.` };
    }
    const inspectedDocs = registers.map((doc) => doc.metadata.doc_id);
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...inspectedDocs],
      detail: `The selected entry ${listed.name} supplies a company identifier, but the parsed register evidence does not verify that identifier for a named counterparty; a name or premises resemblance alone is not conclusive.`
    };
  }
  const listedName = normalizedName(listed.name);
  const listedBirth = monthYear(listed.date_of_birth);
  const relevantRows = [];
  for (const doc of registers) {
    for (const row of doc.extraction.entries) {
      if (row.kind !== "companyOfficer" && row.kind !== "significantControl") continue;
      const person = factIn(row, "person").find((value) => normalizedName(value) === listedName);
      if (!person) continue;
      const born = factIn(row, "birthDetail");
      relevantRows.push({ doc, entry: row, person, born, active: hasActiveRole(row, doc, paymentDate) });
    }
  }
  const identityRows = relevantRows.filter((row) => row.active && row.born.length > 0);
  const corroborating = identityRows.filter((row) => {
    const registerBirth = row.born.map(monthYear).filter((value) => !!value);
    return listedBirth !== void 0 && registerBirth.includes(listedBirth);
  });
  const conflicting = identityRows.filter((row) => {
    const registerBirth = row.born.map(monthYear).filter((value) => !!value);
    return listedBirth !== void 0 && registerBirth.length > 0 && registerBirth.every((value) => value !== listedBirth);
  });
  if (corroborating.length > 0 && conflicting.length > 0) {
    return {
      status: "unresolved",
      evidence: baseEvidence,
      detail: `Parsed registers for the counterparty give conflicting month-and-year-of-birth evidence for ${listed.name}; the identity cannot safely be resolved.`
    };
  }
  if (corroborating.length > 0) {
    const { doc, entry } = corroborating.find((row) => row.entry.kind === "significantControl") ?? corroborating[0];
    const { ends } = roleDates(entry);
    const role = entry.kind === "significantControl" ? "significant control" : "an active officer role";
    const until = ends[0] ? ` (ending on ${ends[0]})` : "";
    return {
      status: "confirmed",
      evidence: [...baseEvidence, doc.metadata.doc_id],
      detail: `Register ${doc.metadata.doc_id} matches ${listed.name}'s birth month and year to list entry ${listed.entry_id} and shows ${role} on the transaction date ${paymentDate}${until}`
    };
  }
  if (conflicting.length > 0) {
    const docs = [...new Set(conflicting.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "different",
      evidence: [...baseEvidence, ...docs],
      detail: `The parsed register for the named counterparty records an active role or significant control for ${listed.name}, but its month and year of birth conflicts with the selected list entry; the shared name is therefore not enough to identify the listed person.`
    };
  }
  const listedUnit = typeof listed.address === "string" ? /^unit\s+([a-z0-9-]+)\s*,?\s+(.+)/i.exec(listed.address.trim()) : null;
  if (typeof matchedOn === "string" && /^registered address\b/i.test(matchedOn) && listedUnit && !relevantRows.length) {
    for (const doc of registers) {
      const office = textFacts(doc.extraction.facts, "registeredOffice");
      if (office.length !== 1) continue;
      const unit = /^unit\s+([a-z0-9-]+)\s*,?\s+(.+)/i.exec(office[0]);
      if (!unit || unit[1].toLowerCase() === listedUnit[1].toLowerCase() || normalizedName(unit[2]) !== normalizedName(listedUnit[2])) continue;
      const controllingOwner = doc.extraction.entries.find((row) => row.kind === "significantControl" && hasActiveRole(row, doc, paymentDate) && factIn(row, "person").some((name) => normalizedName(name) !== listedName) && factIn(row, "control").some((description) => /\b75% or more of (?:the )?shares\b/i.test(description)));
      if (!controllingOwner) continue;
      const controller = factIn(controllingOwner, "person")[0];
      return {
        status: "different",
        evidence: [...baseEvidence, doc.metadata.doc_id],
        detail: `Register ${doc.metadata.doc_id} locates ${companyName(doc)} at Unit ${unit[1]}, not the listed Unit ${listedUnit[1]}, and records ${controller} as holding at least 75% of its shares`
      };
    }
  }
  const listedDay = typeof listed.date_of_birth === "string" && /^\d{4}-\d{2}-\d{2}$/.test(listed.date_of_birth) ? listed.date_of_birth : void 0;
  if (!relevantRows.length && listedDay && tx.counterparty_name && normalizedName(tx.counterparty_name) === listedName) {
    const letters = documents.flatMap((doc) => {
      const gift = giftLetter(doc);
      return gift?.born && normalizedName(gift.donor) === listedName && doc.metadata.dated <= paymentDate ? [{ doc, born: gift.born }] : [];
    });
    const births = new Set(letters.map((letter) => letter.born));
    if (births.size === 1) {
      const [{ doc, born }] = letters;
      const ids2 = letters.map((letter) => letter.doc.metadata.doc_id);
      return born === listedDay ? {
        status: "confirmed",
        evidence: [...baseEvidence, ...ids2],
        detail: `${doc.metadata.doc_id} is signed by ${listed.name}, born ${born}, the same full date of birth as list entry ${listed.entry_id}, who paid the flagged funds on ${paymentDate}`
      } : {
        status: "different",
        evidence: [...baseEvidence, ...ids2],
        detail: `${doc.metadata.doc_id} is signed by the payer ${listed.name}, born ${born}, whereas list entry ${listed.entry_id} records ${listedDay}; the shared name does not identify the listed person`
      };
    }
  }
  if (relevantRows.length > 0 && !listedBirth) {
    const docs = [...new Set(relevantRows.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...docs],
      detail: `A parsed register for the named counterparty contains ${listed.name}, but the selected list entry has no usable date of birth for comparison; name and role alone do not establish identity.`
    };
  }
  if (relevantRows.length > 0) {
    const docs = [...new Set(relevantRows.map((row) => row.doc.metadata.doc_id))];
    return {
      status: "unresolved",
      evidence: [...baseEvidence, ...docs],
      detail: `A parsed register for the named counterparty contains ${listed.name}, but it does not establish a matching birth month and year in a role or control record active on ${paymentDate}; the list match remains undecided.`
    };
  }
  return {
    status: "unresolved",
    evidence: baseEvidence,
    detail: `The selected list entry is ${listed.name}. The supplied parsed register evidence does not independently link that identity to a named counterparty, and a name or premises match alone is not conclusive.`
  };
}

// src/llm/facts.ts
var PAYMENT_PURPOSES = [
  "gift",
  "inheritance",
  "legal_settlement",
  "insurance_payout",
  "refund",
  "loan",
  "asset_sale",
  "deposit_return",
  "investment_redemption",
  "supplier_payment",
  "salary",
  "other"
];
var NO_FINDINGS = { explanations: [], signals: [] };
function quoteKey(text2) {
  return norm(text2.replace(/\*\*/g, "").replace(/[“”]/g, '"').replace(/[–—]/g, "-"));
}
function quoted(text2, quote) {
  const key = quote ? quoteKey(quote) : "";
  return key.length >= 3 && quoteKey(text2).includes(key);
}
function backed(text2, value, quote) {
  return !!value && quoted(text2, quote) && quoteKey(quote).includes(quoteKey(value));
}
var short = (quote) => {
  const flat = quote.replace(/\s+/g, " ").trim();
  return flat.length > 160 ? `${flat.slice(0, 157)}...` : flat;
};
var label2 = (s) => s.replace(/\s+/g, " ").trim();
var refHas2 = (tx, ref) => typeof tx.reference === "string" && new RegExp(`(?:^|[^a-z0-9])${norm(ref).replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?:$|[^a-z0-9])`).test(norm(tx.reference));
var isCash2 = (tx) => typeof tx.channel === "string" && tx.channel.includes("cash");
function checkPayments(doc, facts) {
  const md = doc.markdown;
  return facts.payments.flatMap((fact) => {
    if (fact.status !== "confirmed" && fact.status !== "scheduled") return [];
    if (!backed(md, fact.counterparty, fact.counterparty_quote) || !quoted(md, fact.amount_quote)) return [];
    const [pence2] = poundsIn(fact.amount);
    if (pence2 === void 0 || !poundsIn(fact.amount_quote).includes(pence2)) return [];
    if (fact.reference && !backed(md, fact.reference, fact.reference_quote)) return [];
    if (fact.recipient && !backed(md, fact.recipient, fact.recipient_quote)) return [];
    let due;
    if (fact.due_date) {
      if (!backed(md, fact.due_date, fact.due_date_quote)) return [];
      due = isoDay(fact.due_date);
      if (!due) return [];
    }
    return [{ fact, pence: pence2, due, reference: fact.reference ?? void 0 }];
  });
}
var OWNS_ALL = /\b(?:100\s?%|entire|all (?:of )?the (?:issued )?shares|whole of the (?:issued )?share|wholly[- ]owned)/i;
function checkOwnership(doc, facts) {
  return facts.ownership.filter((fact) => quoted(doc.markdown, fact.quote) && quoteKey(fact.quote).includes(quoteKey(fact.parent)) && quoteKey(fact.quote).includes(quoteKey(fact.subsidiary)) && OWNS_ALL.test(fact.quote));
}
var CLOSE_FOR = {
  gift: "THIRD_PARTY_DOCUMENTED",
  inheritance: "DOCUMENTED_EVENT",
  legal_settlement: "DOCUMENTED_EVENT",
  insurance_payout: "DOCUMENTED_EVENT",
  loan: "DOCUMENTED_EVENT",
  asset_sale: "DOCUMENTED_EVENT",
  deposit_return: "DOCUMENTED_EVENT",
  investment_redemption: "DOCUMENTED_EVENT",
  refund: "REFUND_OF_EARLIER_PAYMENT",
  supplier_payment: "INVOICE_MATCHES"
};
var PURPOSE_DOCUMENT = /invoice|contract|schedule|agreement|purchase_order/;
var ARRIVAL_DAYS = 60;
var paidBy = (tx, party) => !!tx.counterparty_name && (sameName(tx.counterparty_name, party) || nameKey(tx.counterparty_name).startsWith(nameKey(party)));
function unique(items) {
  return items.length === 1 ? items[0] : void 0;
}
function explainFromDocument(pack, doc, facts) {
  const customer = pack.customer.name;
  const day = doc.metadata.dated;
  const history = [...pack.priorTransactions, ...pack.windowTransactions, ...pack.heldPayment ? [pack.heldPayment] : []];
  const subjects = [...new Map([...pack.windowTransactions, ...pack.flaggedTransactions, ...pack.heldPayment ? [pack.heldPayment] : []].map((tx) => [tx.transaction_id, tx])).values()];
  const results = [];
  const cite = (q) => `"${short(q)}"`;
  for (const { fact, pence: pence2, due, reference } of checkPayments(doc, facts)) {
    const code = CLOSE_FOR[fact.purpose];
    if (!code) continue;
    const toCustomer = fact.recipient ? sameName(fact.recipient, customer) || /^you(?:rself)?$/i.test(fact.recipient.trim()) : fact.purpose !== "gift";
    if (fact.direction === "to_customer") {
      if (!toCustomer || code === "INVOICE_MATCHES") continue;
      const tx = unique(subjects.filter((t) => t.direction === "in" && !isCash2(t) && samePence(t, pence2) && paidBy(t, fact.counterparty) && txDay(t) >= day && daysBetween(day, txDay(t)) <= ARRIVAL_DAYS && (!reference || refHas2(t, reference))));
      if (!tx) continue;
      if (code === "REFUND_OF_EARLIER_PAYMENT") {
        const original = unique(history.filter((t) => t.direction === "out" && t.booked_at < tx.booked_at && samePence(t, pence2) && sameName(t.counterparty_name, tx.counterparty_name) && (!reference || refHas2(t, reference))));
        if (!original) continue;
        results.push({ tx, explanation: {
          code,
          docs: [doc.metadata.doc_id],
          related: [original.transaction_id],
          fact: `${doc.metadata.doc_id} confirms a refund from ${label2(fact.counterparty)} (${cite(fact.amount_quote)}), linking ${describe(tx)} to the original payment of ${describe(original)}`
        } });
        continue;
      }
      results.push({ tx, explanation: {
        code,
        docs: [doc.metadata.doc_id],
        related: [],
        fact: `${doc.metadata.doc_id} from ${label2(fact.counterparty)} records the ${fact.purpose.replace(/_/g, " ")} for ${label2(customer)} (${cite(fact.amount_quote)}), matching ${describe(tx)}`
      } });
    } else {
      if (code !== "INVOICE_MATCHES" || !PURPOSE_DOCUMENT.test(doc.metadata.type) || !due && !reference) continue;
      const tx = unique(subjects.filter((t) => t.direction === "out" && samePence(t, pence2) && sameName(t.counterparty_name, fact.counterparty) && day <= txDay(t) && (!due || txDay(t) === due) && (!reference || refHas2(t, reference))));
      if (!tx) continue;
      results.push({ tx, explanation: {
        code,
        docs: [doc.metadata.doc_id],
        related: [],
        fact: `${doc.metadata.doc_id} sets a payment of ${cite(fact.amount_quote)} to ${label2(fact.counterparty)}${due ? ` due on ${due}` : ""}${reference ? ` under ${reference}` : ""}, matching ${describe(tx)}`
      } });
    }
  }
  const owned = checkOwnership(doc, facts);
  const parentOf = (company) => owned.find((o) => sameName(o.subsidiary, company))?.parent;
  for (const tx of subjects.filter((t) => t.direction === "in" && t.counterparty_name && day <= txDay(t))) {
    const payer = tx.counterparty_name;
    if (sameName(payer, customer)) continue;
    const parent = parentOf(customer);
    const link = parent && sameName(parent, payer) ? owned.find((o) => sameName(o.parent, payer) && sameName(o.subsidiary, customer)) : parent && parentOf(payer) && sameName(parentOf(payer), parent) ? owned.find((o) => sameName(o.subsidiary, payer)) : void 0;
    if (!link) continue;
    results.push({ tx, explanation: {
      code: "GROUP_COMPANY",
      docs: [doc.metadata.doc_id],
      related: [],
      fact: `${doc.metadata.doc_id} states ${cite(link.quote)}, so ${label2(payer)} and ${label2(customer)} are in the same wholly owned group, explaining ${describe(tx)}`
    } });
  }
  return results;
}
function speakerText(doc) {
  if (doc.metadata.type !== "support_chat") return doc.markdown.replace(/^#.*$/m, "");
  return [...doc.markdown.matchAll(/^\*\*Customer:\*\*\s*(.+)$/gim)].map((m) => m[1]).join("\n");
}
function signalsFromDocument(pack, doc, facts) {
  const text2 = speakerText(doc);
  const id = doc.metadata.doc_id;
  const name = label2(pack.customer.name);
  const signals = [];
  const largest3 = (txs) => [...txs].sort((a, b) => b.amount_gbp - a.amount_gbp || a.transaction_id.localeCompare(b.transaction_id))[0];
  const ruleTxs = (...rules) => pack.alerts.filter((a) => rules.includes(a.rule_id)).flatMap((a) => a.transaction_ids);
  if (facts.structuring.present && quoted(text2, facts.structuring.quote)) {
    signals.push({
      code: "ESC_STRUCTURING",
      evidence: [id, ...ruleTxs("TM03", "TM05")],
      fact: `${id} records amounts being kept under a limit to avoid the related checks: "${short(facts.structuring.quote)}"`
    });
  }
  if (facts.account_used_by_others.present && quoted(text2, facts.account_used_by_others.quote)) {
    const tx = largest3(pack.flaggedTransactions.filter((t) => t.direction === "in" && !sameName(t.counterparty_name, pack.customer.name)));
    signals.push({
      code: "ESC_ACCOUNT_MISUSE",
      evidence: [id, ...tx ? [tx.transaction_id] : []],
      fact: `${id} records someone other than ${name} using the account: "${short(facts.account_used_by_others.quote)}"${tx ? `; it received ${describe(tx)}` : ""}`
    });
  }
  const routed = ruleTxs("TM06");
  if (routed.length && facts.refused_to_explain.present && quoted(text2, facts.refused_to_explain.quote)) {
    signals.push({
      code: "ESC_HIGH_RISK_CORRIDOR",
      evidence: [id, ...routed],
      fact: `${id} records that ${name} would not explain the flagged higher-risk-country payments: "${short(facts.refused_to_explain.quote)}"`
    });
  }
  return signals;
}

// src/signals.ts
var label3 = (s) => s.replace(/\s+/g, " ").trim();
var largest = (txs) => [...txs].sort((a, b) => b.amount_gbp - a.amount_gbp)[0];
function customerDocs(pack, ...types) {
  return pack.documents.filter((doc) => doc.metadata.customer_id === pack.customer.customer_id && types.includes(doc.metadata.type));
}
function companyOf(doc) {
  return field2(doc.markdown, "Company") ?? /^Company register extract for (.+?)(?::.*)?$/i.exec(title(doc.markdown))?.[1];
}
function controllers(doc) {
  return [
    ...tableRows(doc.markdown, ["officer", "role"]).map((row) => row.officer),
    ...tableRows(doc.markdown, ["person with significant control"]).map((row) => row["person with significant control"]),
    ...tableRows(doc.markdown, ["person", "control"]).map((row) => row.person)
  ].filter(Boolean);
}
var STRUCTURING_LIMIT = /\b(?:below|under|less than)\s+(?:the\s+)?(?:£\s?[\d,]+|a grand|\d+\s?k\b)|\b(?:below|under)\b[^.\n]{0,130}\b(?:threshold|limit)\b/i;
var STRUCTURING_PURPOSE = /\b(?:exempt\w*|avoid\w*|evad\w*|bypass\w*|circumvent\w*|identity|identification|verification|ID checks?|reporting|invoice requirement|source of (?:the )?(?:cash|funds|money)|where (?:it|the cash|the money) came from)\b/i;
var admitsStructuring = (text2) => STRUCTURING_LIMIT.test(text2) && (STRUCTURING_PURPOSE.test(text2) || /\bID\b/.test(text2));
var customerTurns = (markdown) => [...markdown.matchAll(/^\*\*Customer:\*\*\s*(.+)$/gim)].map((m) => m[1]).join("\n");
var ACCOUNT_USED_BY_OTHERS = /^\*\*Customer:\*\*.*\b(?:through|via|using) (?:mine|my account)\b/im;
var REFUSAL = /\b(?:unable|unwilling|declin\w*|evasive|refus\w*|would not|did not (?:explain|provide|clarify))\b|\bno clear\b/i;
function findSignals(pack, explained) {
  const signals = [];
  const { from } = pack.caseRecord.review_window;
  const flagged = pack.flaggedTransactions;
  const subjects = [...new Map([...pack.windowTransactions, ...flagged, ...pack.heldPayment ? [pack.heldPayment] : []].map((tx) => [tx.transaction_id, tx])).values()];
  const currentNotes = customerDocs(pack, "staff_note").filter((doc) => (isoDay(doc.metadata.dated) ?? "") >= from);
  const casePaymentIds = new Set([...flagged, ...pack.heldPayment ? [pack.heldPayment] : []].map((tx) => tx.transaction_id));
  for (const { doc, tx, detail } of explained.invoicePayeeConflicts) {
    if (!casePaymentIds.has(tx.transaction_id)) continue;
    signals.push({
      code: "ESC_INVOICE_MISMATCH",
      evidence: [doc.metadata.doc_id, tx.transaction_id],
      fact: `${doc.metadata.doc_id} ${detail}, contradicting ${describe(tx)}`
    });
  }
  for (const note of currentNotes) {
    const text2 = note.markdown.replace(/^#.*$/m, "");
    if (admitsStructuring(text2)) {
      const split = pack.alerts.filter((alert) => alert.rule_id === "TM03" || alert.rule_id === "TM05").flatMap((alert) => alert.transaction_ids);
      signals.push({
        code: "ESC_STRUCTURING",
        evidence: [note.metadata.doc_id, ...split],
        fact: `Staff note ${note.metadata.doc_id} records ${label3(pack.customer.name)} asking how to keep payments below a threshold to avoid the related checks`
      });
    }
    const countries = pack.alerts.flatMap((alert) => alert.rule_id === "TM06" ? String(alert.measured?.countries ?? "").split(/,\s*/) : []).filter(Boolean);
    const named = [...countries, ...HIGHER_RISK_COUNTRIES].some((country) => norm(text2).includes(norm(country)));
    if (countries.length && REFUSAL.test(text2) && named) {
      const routed = pack.alerts.filter((alert) => alert.rule_id === "TM06").flatMap((alert) => alert.transaction_ids);
      signals.push({
        code: "ESC_HIGH_RISK_CORRIDOR",
        evidence: [note.metadata.doc_id, ...routed],
        fact: `Staff note ${note.metadata.doc_id} records that the customer could not or would not explain the routing of the flagged payments through ${countries.join(", ")}`
      });
    }
  }
  for (const chat of customerDocs(pack, "support_chat").filter((doc) => (isoDay(doc.metadata.dated) ?? "") >= from)) {
    if (admitsStructuring(customerTurns(chat.markdown))) {
      const split = pack.alerts.filter((alert) => alert.rule_id === "TM03" || alert.rule_id === "TM05").flatMap((alert) => alert.transaction_ids);
      signals.push({
        code: "ESC_STRUCTURING",
        evidence: [chat.metadata.doc_id, ...split],
        fact: `In chat ${chat.metadata.doc_id} ${label3(pack.customer.name)} says they keep each payment under a limit so that the related checks are not triggered`
      });
    }
    const line = ACCOUNT_USED_BY_OTHERS.exec(chat.markdown)?.[0];
    if (!line) continue;
    const tx = largest(flagged.filter((t) => t.direction === "in" && !sameName(t.counterparty_name, pack.customer.name)));
    signals.push({
      code: "ESC_ACCOUNT_MISUSE",
      evidence: [chat.metadata.doc_id, ...tx ? [tx.transaction_id] : []],
      fact: `In chat ${chat.metadata.doc_id} ${label3(pack.customer.name)} says other people are using the account (${label3(line.replace(/^\*\*Customer:\*\*\s*/, ""))})${tx ? `, which received ${describe(tx)}` : ""}`
    });
  }
  for (const doc of customerDocs(pack, "device_export")) {
    for (const row of tableRows(doc.markdown, ["customers who logged in from it"])) {
      const users = row["customers who logged in from it"].split(/\s*,\s*/).filter(Boolean);
      if (users.includes(pack.customer.customer_id) && users.length >= 2) {
        const tx = largest(flagged);
        signals.push({
          code: "ESC_ACCOUNT_MISUSE",
          evidence: [doc.metadata.doc_id, ...tx ? [tx.transaction_id] : []],
          fact: `Device export ${doc.metadata.doc_id} shows device ${row.device ?? ""} used to log in to ${users.length} different customers' accounts, including ${label3(pack.customer.name)}'s, from ${row["login countries"] ?? "several countries"}`
        });
      }
    }
  }
  const registers = pack.documents.filter((doc) => doc.metadata.type === "company_register_extract" || doc.metadata.type === "significant_control_register");
  for (const tx of flagged.filter((t) => t.direction === "in" && t.counterparty_name)) {
    const register = registers.find((doc) => sameName(companyOf(doc), tx.counterparty_name));
    const dissolved = register && isoDay(/^Dissolved on (.+)$/i.exec(field2(register.markdown, "Status") ?? "")?.[1]);
    if (!register || !dissolved || dissolved > txDay(tx)) continue;
    const onward = flagged.filter((t) => t.direction === "out" && !explained.byTx.has(t.transaction_id) && t.amount_gbp >= 500 && !sameName(t.counterparty_name, pack.customer.name));
    const individuals = new Set(onward.filter((t) => !looksLikeOrganization(t.counterparty_name)).map((t) => nameKey(t.counterparty_name ?? "")));
    const out = largest(onward);
    signals.push({
      code: individuals.size >= 2 ? "ESC_PASS_THROUGH" : "ESC_UNEXPLAINED_FUNDS",
      evidence: [register.metadata.doc_id, tx.transaction_id, ...out ? [out.transaction_id] : []],
      fact: `Register ${register.metadata.doc_id} shows the payer ${label3(tx.counterparty_name)} was dissolved on ${dissolved}, before it apparently paid ${describe(tx)}${out ? `, and the money was moved on, including ${describe(out)}` : ""}`
    });
    break;
  }
  const own = registers.filter((doc) => sameName(companyOf(doc), pack.customer.name)).flatMap(controllers).map(nameKey);
  if (own.length) {
    for (const tx of subjects.filter((t) => t.direction === "out" && t.counterparty_name && !explained.byTx.has(t.transaction_id))) {
      const register = registers.find((doc) => sameName(companyOf(doc), tx.counterparty_name) && controllers(doc).some((p) => own.includes(nameKey(p))));
      if (!register) continue;
      const person = controllers(register).find((p) => own.includes(nameKey(p)));
      signals.push({
        code: "ESC_PASS_THROUGH",
        evidence: [register.metadata.doc_id, tx.transaction_id],
        fact: `Register ${register.metadata.doc_id} shows ${person}, who controls ${label3(pack.customer.name)}, also controls the payee of ${describe(tx)}`
      });
      break;
    }
  }
  for (const doc of customerDocs(pack, "supplier_invoices", "supplier_invoice", "invoice", "freight_invoices")) {
    const rows = tableRows(doc.markdown, ["invoice", "amount"]);
    const mismatched = subjects.filter((tx) => tx.direction === "out" && !explained.byTx.has(tx.transaction_id)).flatMap((tx) => {
      const row = rows.find((r) => typeof tx.reference === "string" && norm(tx.reference) === norm(r.invoice));
      const dated2 = row && isoDay(row.dated);
      return row && (!samePence(tx, pounds(row.amount)) || !!dated2 && dated2 > txDay(tx)) ? [{ tx, row }] : [];
    });
    if (mismatched.length) {
      const [{ tx, row }] = mismatched;
      signals.push({
        code: "ESC_INVOICE_MISMATCH",
        evidence: [doc.metadata.doc_id, ...mismatched.map((m) => m.tx.transaction_id)],
        fact: `${doc.metadata.doc_id} does not support ${describe(tx)}: invoice ${row.invoice} is for ${row.amount}${row.dated ? ` dated ${row.dated}` : ""}`
      });
    }
  }
  for (const doc of customerDocs(pack, "payment_file")) {
    const rows = tableRows(doc.markdown, ["payee", "address", "amount"]);
    const addresses = new Set(rows.map((row) => norm(row.address)));
    if (rows.length >= 10 && addresses.size * 3 <= rows.length) {
      const pool = largest(flagged.filter((t) => t.direction === "in" && !sameName(t.counterparty_name, pack.customer.name)));
      signals.push({
        code: "ESC_MULE_ACTIVITY",
        evidence: [doc.metadata.doc_id, ...pool ? [pool.transaction_id] : []],
        fact: `Payment file ${doc.metadata.doc_id} pays ${rows.length} overseas payees who share only ${addresses.size} UK addresses${pool ? `, funded by ${describe(pool)}` : ""}`
      });
    }
  }
  return signals;
}

// src/decision.ts
var reasonCodes = {
  CLOSE: [
    "COLLECTION_DOCUMENTED",
    "BUSINESS_RECORDS_RECONCILE",
    "DOCUMENTED_EVENT",
    "INVOICE_MATCHES",
    "OWN_ACCOUNT",
    "GROUP_COMPANY",
    "THIRD_PARTY_DOCUMENTED",
    "REFUND_OF_EARLIER_PAYMENT",
    "RETURNING_CUSTOMER",
    "LIST_MATCH_DIFFERENT_PARTY",
    "WITHIN_PROFILE"
  ],
  RFI: ["RFI_PURPOSE_DOCUMENTS", "RFI_BUSINESS_RECORDS", "RFI_SOURCE_OF_FUNDS", "RFI_COUNTERPARTY_DETAILS", "RFI_UPDATED_PROFILE"],
  ESCALATE: [
    "ESC_MULE_ACTIVITY",
    "ESC_STRUCTURING",
    "ESC_UNEXPLAINED_FUNDS",
    "ESC_PASS_THROUGH",
    "ESC_INVOICE_MISMATCH",
    "ESC_HIGH_RISK_CORRIDOR",
    "ESC_ACCOUNT_MISUSE",
    "ESC_THIRD_PARTY_FUNDING",
    "ESC_EARLY_REDEMPTION",
    "ESC_LISTED_PARTY"
  ]
};
var gbp2 = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
var label4 = (s) => s.replace(/\s+/g, " ").trim();
var sentence = (s) => `${label4(s).replace(/[.!?]+$/, "")}.`;
var distinct = (items) => [...new Set(items)];
var record2 = (value) => value && typeof value === "object" && !Array.isArray(value) ? value : {};
var num = (value) => typeof value === "number" && Number.isFinite(value) ? value : void 0;
var largest2 = (txs) => [...txs].sort((a, b) => b.amount_gbp - a.amount_gbp || a.transaction_id.localeCompare(b.transaction_id))[0];
var sumPence = (txs) => txs.reduce((total, tx) => total + (pence(tx.amount_gbp) ?? 0), 0);
var SUSPICION_ORDER = [
  "ESC_LISTED_PARTY",
  "ESC_STRUCTURING",
  "ESC_INVOICE_MISMATCH",
  "ESC_ACCOUNT_MISUSE",
  "ESC_EARLY_REDEMPTION",
  "ESC_HIGH_RISK_CORRIDOR",
  "ESC_UNEXPLAINED_FUNDS",
  "ESC_MULE_ACTIVITY",
  "ESC_PASS_THROUGH",
  "ESC_THIRD_PARTY_FUNDING"
];
var GAP_ORDER = ["TM22", "RELEASE", "TM08", "TM02", "TM04", "TM03", "TM10", "TM06", "TM07", "TM05", "TM01", "PROFILE"];
var CLOSE_OVERRIDES = ["LIST_MATCH_DIFFERENT_PARTY", "RETURNING_CUSTOMER", "GROUP_COMPANY", "COLLECTION_DOCUMENTED", "REFUND_OF_EARLIER_PAYMENT"];
var RELEASE_DOCUMENT_TYPES = /* @__PURE__ */ new Set(["invoice", "supplier_invoice", "carrier_invoice", "dealer_invoice", "hospital_invoice", "contract_schedule"]);
function material(alert, tx) {
  if (tx.channel === "card") return false;
  if (["TM02", "TM04", "TM07"].includes(alert.rule_id) && tx.direction === "out" && (tx.channel === "direct_debit" || tx.channel === "standing_order")) return false;
  return true;
}
function baselineOf(pack, alert) {
  const measured = num(record2(alert?.measured).baseline_gbp);
  if (measured && measured > 0) return measured;
  const declared = record2(pack.customer.declared);
  const income = num(declared.monthly_income_gbp);
  const annual = num(declared.annual_turnover_gbp);
  return income && income > 0 ? income : annual && annual > 0 ? annual / 12 : void 0;
}
function profileRatio(pack) {
  const tm01 = pack.alerts.find((alert) => alert.rule_id === "TM01");
  const baseline = baselineOf(pack, tm01);
  const received = num(record2(tm01?.measured).received_gbp);
  const total = received !== void 0 ? pence(received) ?? Math.round(received * 100) : sumPence(pack.windowTransactions.filter((tx) => tx.direction === "in"));
  if (!baseline) {
    const multiple = num(record2(tm01?.measured).multiple);
    return multiple === void 0 ? void 0 : { multiple, atLeastFive: multiple >= 5 };
  }
  return { multiple: total / 100 / baseline, atLeastFive: total >= Math.round(5 * baseline * 100) };
}
function closeCode(items) {
  for (const code of CLOSE_OVERRIDES) if (items.some((item) => item.explanation.code === code)) return code;
  const documented = items.filter((item) => item.explanation.code !== "WITHIN_PROFILE");
  const top = [...documented.length ? documented : items].sort((a, b) => b.tx.amount_gbp - a.tx.amount_gbp || a.tx.transaction_id.localeCompare(b.tx.transaction_id))[0];
  return top?.explanation.code ?? "WITHIN_PROFILE";
}
function covered(pack, alert, txs, open) {
  const measured = record2(alert.measured);
  switch (alert.rule_id) {
    case "TM01": {
      if (txs.some((tx) => tx.direction === "out" && open.includes(tx))) return false;
      const residual = open.filter((tx) => tx.direction === "in");
      if (residual.some((tx) => !sameName(tx.counterparty_name, pack.customer.name))) return false;
      const baseline = baselineOf(pack, alert);
      const multiple = num(measured.limit_multiple) ?? (pack.customer.kind === "business" ? 2 : 3);
      return !!baseline && sumPence(residual) <= Math.round(multiple * baseline * 100);
    }
    case "TM10":
      return open.length === 0 && txs.some((tx) => tx.channel === "fund_redemption");
    case "TM02":
      return !open.some((tx) => tx.direction === "out") && sumPence(open.filter((tx) => tx.direction === "in")) < 2e5;
    case "TM04": {
      const limit = num(measured.limit) ?? 6;
      return new Set(open.map((tx) => nameKey(tx.counterparty_name ?? tx.transaction_id))).size <= limit;
    }
    case "TM06":
    case "TM07":
      return sumPence(open) < Math.round((num(measured.limit_gbp) ?? 5e3) * 100);
    default:
      return open.length === 0;
  }
}
var isCrypto = (tx) => /\b(?:exchange|crypto\w*|coin\w*|digital assets?|digital currenc\w*|blockchain|tokens?)\b/i.test(tx.counterparty_name ?? "") || /\b(?:btc|eth|usdt|usdc|bitcoin|ethereum|crypto\w*|stablecoin\w*)\b/i.test(typeof tx.reference === "string" ? tx.reference : "");
var abroad = (tx) => !!tx.counterparty_country && norm(String(tx.counterparty_country)) !== "united kingdom";
function rapidMovementSuspicion(pack, open) {
  const outs = open.filter((tx) => tx.direction === "out" && tx.amount_gbp >= 500 && !sameName(tx.counterparty_name, pack.customer.name));
  const ins = open.filter((tx) => tx.direction === "in");
  const individuals = new Set(outs.filter((tx) => !looksLikeOrganization(tx.counterparty_name)).map((tx) => nameKey(tx.counterparty_name ?? "")));
  const crypto = outs.filter(isCrypto);
  const overseasPeople = outs.filter((tx) => abroad(tx) && !looksLikeOrganization(tx.counterparty_name));
  if (!crypto.length && !overseasPeople.length && individuals.size < 2) return;
  const out = largest2(crypto.length ? crypto : overseasPeople.length ? overseasPeople : outs);
  const inn = largest2(ins);
  const payers = new Set(ins.filter((tx) => tx.counterparty_name && !sameName(tx.counterparty_name, pack.customer.name)).map((tx) => nameKey(tx.counterparty_name)));
  const cash = ins.some((tx) => typeof tx.channel === "string" && tx.channel.includes("cash"));
  const code = crypto.length && payers.size >= 2 ? "ESC_MULE_ACTIVITY" : cash ? "ESC_UNEXPLAINED_FUNDS" : "ESC_PASS_THROUGH";
  const where = crypto.length ? `to the crypto exchange ${label4(out.counterparty_name ?? "")}` : overseasPeople.length ? `to an individual abroad` : `to ${individuals.size} unrelated individuals`;
  return {
    code,
    rank: 0,
    evidence: [...inn ? [inn.transaction_id] : [], out.transaction_id],
    fact: inn ? `${describe(inn)} was received and funds moved on within days ${where}, including ${describe(out)}, with neither leg explained` : `Funds moved on within days ${where}, including ${describe(out)}, and the onward payment has no credible explanation`
  };
}
function gapFor(pack, alert, open, index) {
  const name = label4(pack.customer.name);
  const rank = GAP_ORDER.indexOf(alert.rule_id) >= 0 ? GAP_ORDER.indexOf(alert.rule_id) : GAP_ORDER.length;
  const subject = largest2(open) ?? largest2(alert.transaction_ids.map((id) => pack.flaggedTransactions.find((tx) => tx.transaction_id === id)).filter(Boolean));
  const evidence = subject ? [subject.transaction_id] : [];
  const what = subject ? describe(subject) : `the activity flagged by ${alert.alert_id}`;
  const onward = open.map((tx) => index.unexplainedOnward.get(tx.transaction_id)).find(Boolean);
  const fact = `${alert.rule_id} flagged ${what} and nothing on file explains it`;
  if (onward) {
    return {
      code: "RFI_PURPOSE_DOCUMENTS",
      rank,
      evidence: [...evidence, onward.transaction_id],
      fact: `${alert.rule_id} flagged ${what}, which funded ${describe(onward)} with no invoice or contract on file`,
      request: `Ask ${name} for the invoice, purchase order or contract supporting the payment of ${describe(onward)}`
    };
  }
  switch (alert.rule_id) {
    case "TM01":
    case "TM05":
      return {
        code: "RFI_SOURCE_OF_FUNDS",
        rank,
        evidence,
        fact,
        request: `Ask ${name} for documents showing where the money for ${what} came from, such as a sale, settlement, inheritance or account statement`
      };
    case "TM07": {
      const out = largest2(open.filter((tx) => tx.direction === "out"));
      return out ? {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence: distinct([...evidence, out.transaction_id]),
        fact,
        request: `Ask ${name} for the invoice or instruction supporting ${describe(out)} after the account reactivated`
      } : {
        code: "RFI_SOURCE_OF_FUNDS",
        rank,
        evidence,
        fact,
        request: `Ask ${name} for a statement of the sending account, in their name, that shows the source of ${what}`
      };
    }
    case "TM03":
      return pack.caseRecord.institution === "payments_fx" ? {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence: alert.transaction_ids,
        fact: `${alert.rule_id} flagged repeated payments just under \xA310,000, including ${what}, with no contract or schedule on file`,
        request: `Ask ${name} for the contract or payment schedule that sets the amount and timing of each flagged payment`
      } : {
        code: "RFI_BUSINESS_RECORDS",
        rank,
        evidence: alert.transaction_ids,
        fact: `${alert.rule_id} flagged repeated cash amounts just under the threshold, including ${what}, with no business records on file`,
        request: `Ask ${name} for the takings or collection records behind each flagged cash payment in the review window`
      };
    case "TM08":
      return {
        code: "RFI_COUNTERPARTY_DETAILS",
        rank,
        evidence,
        fact: `${alert.rule_id} flagged ${what} from an account not in ${name}'s name`,
        request: `Ask ${name} who ${subject?.counterparty_name ? label4(subject.counterparty_name) : "the other party"} is, their relationship to the customer, and the document behind the transfer`
      };
    case "TM10": {
      const sold = largest2(open.filter((tx) => tx.channel === "fund_redemption")) ?? subject;
      const bought = largest2(open.filter((tx) => tx.channel === "fund_subscription"));
      return {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence: distinct([...bought ? [bought.transaction_id] : [], ...sold ? [sold.transaction_id] : []]),
        fact: `${alert.rule_id} flagged fund units ${bought ? `bought as ${describe(bought)} and ` : ""}sold back early${sold ? ` as ${describe(sold)}` : ""}, and nothing on file explains why`,
        request: `Ask ${name} why the units were sold within 90 days of purchase and for a document supporting that reason, such as evidence of the change in circumstances`
      };
    }
    case "TM02": {
      const inn = largest2(open.filter((tx) => tx.direction === "in"));
      const out = largest2(open.filter((tx) => tx.direction === "out"));
      if (out && !inn) {
        return {
          code: "RFI_PURPOSE_DOCUMENTS",
          rank,
          evidence: open.filter((tx) => tx.direction === "out").map((tx) => tx.transaction_id),
          fact: `${alert.rule_id} flagged rapid movement of funds, but the onward payment of ${describe(out)} is not explained`,
          request: `Ask ${name} for the invoice, contract or transfer instruction supporting the unexplained onward payment${open.length === 1 ? "" : "s"}`
        };
      }
      return {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence: distinct([...inn ? [inn.transaction_id] : [], ...out ? [out.transaction_id] : []]),
        fact: `${alert.rule_id} flagged money moving through the account within days${inn ? `, including ${describe(inn)}` : ""}${out ? ` and ${describe(out)}` : ""}; no document on file explains the unresolved activity`,
        request: `Ask ${name} for the documents behind ${inn ? "the incoming payment" : "the funds"}${out ? " and the onward payment, such as the agreement, letter or invoice for each" : ""}`
      };
    }
    case "TM04":
      return {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence,
        fact: `${alert.rule_id} flagged payments with many different counterparties, including ${what}`,
        request: `Ask ${name} for the booking, payment file or invoices that show who the counterparties are and what each payment was for`
      };
    default:
      return {
        code: "RFI_PURPOSE_DOCUMENTS",
        rank,
        evidence,
        fact,
        request: `Ask ${name} for the invoice, agreement or instruction showing the purpose of ${what}`
      };
  }
}
function decideCase(pack, findings = NO_FINDINGS) {
  const { caseRecord, customer, alerts, documents, heldPayment } = pack;
  const index = explainTransactions(pack, findings.explanations);
  const flagged = new Map(pack.flaggedTransactions.map((tx) => [tx.transaction_id, tx]));
  if (heldPayment) flagged.set(heldPayment.transaction_id, heldPayment);
  const suspicions = [];
  const gaps = [];
  const covers = [];
  const rankOf = (code2) => SUSPICION_ORDER.indexOf(code2) + 1;
  const { from } = caseRecord.review_window;
  const reports = documents.filter(({ metadata }) => metadata.type === "sending_bank_fraud_report" && metadata.dated >= from);
  if (reports.length) {
    const subjects = distinct(reports.flatMap((doc) => /^\*\*Subject:\*\*\s*(.+)$/im.exec(doc.markdown)?.[1] ?? []).map(label4));
    const sample = largest2(pack.flaggedTransactions.filter((tx) => tx.direction === "in"));
    suspicions.push({
      code: "ESC_MULE_ACTIVITY",
      rank: 0,
      evidence: [...reports.map((d) => d.metadata.doc_id), ...sample ? [sample.transaction_id] : []],
      fact: `Sending-bank fraud ${reports.length === 1 ? "report" : "reports"} ${reports.map((d) => d.metadata.doc_id).join(", ")} ${subjects.length ? `record ${subjects.join("; ")} for money paid into` : "raise a fraud concern about"} ${label4(customer.name)}'s account${sample ? `, including ${describe(sample)}` : ""}`
    });
  }
  for (const signal of [...findSignals(pack, index), ...findings.signals]) suspicions.push({ ...signal, rank: rankOf(signal.code) });
  for (const alert of alerts) {
    const txs = alert.transaction_ids.map((id) => flagged.get(id)).filter(Boolean);
    if (alert.rule_id === "TM22") {
      const assessment = assessListMatch({ measured: alert.measured }, pack.internalList, documents, txs);
      const tx = txs.find((t) => t.transaction_id === assessment.transactionId) ?? largest2(txs);
      const evidence2 = distinct([...assessment.evidence, ...tx ? [tx.transaction_id] : []]);
      if (assessment.status === "confirmed") {
        suspicions.push({ code: "ESC_LISTED_PARTY", rank: rankOf("ESC_LISTED_PARTY"), evidence: evidence2, fact: assessment.detail });
      } else if (assessment.status === "different") {
        covers.push({
          alert,
          code: "LIST_MATCH_DIFFERENT_PARTY",
          fact: assessment.detail,
          evidence: evidence2,
          explanations: txs.flatMap((t) => index.byTx.has(t.transaction_id) ? [{ tx: t, explanation: index.byTx.get(t.transaction_id) }] : [])
        });
      } else {
        gaps.push({
          code: "RFI_COUNTERPARTY_DETAILS",
          rank: GAP_ORDER.indexOf("TM22"),
          evidence: evidence2,
          fact: assessment.detail,
          request: `For ${tx ? describe(tx) : alert.alert_id}, ask for official identification of the matched counterparty or officer that distinguishes them from the listed party`
        });
      }
      continue;
    }
    const relevant = txs.filter((tx) => material(alert, tx));
    const open = relevant.filter((tx) => !index.byTx.has(tx.transaction_id));
    const explanations = relevant.flatMap((tx) => index.byTx.has(tx.transaction_id) ? [{ tx, explanation: index.byTx.get(tx.transaction_id) }] : []);
    if (explanations.length && covered(pack, alert, relevant, open)) {
      const first = [...relevant].sort((a, b) => a.booked_at.localeCompare(b.booked_at))[0];
      const reverified = alert.rule_id === "TM07" && first && documents.find((doc) => doc.metadata.type === "reverification_record" && doc.metadata.dated <= txDay(first) && daysBetween(doc.metadata.dated, txDay(first)) <= 14 && /re-?verified/i.test(doc.markdown));
      covers.push(reverified ? {
        alert,
        code: "RETURNING_CUSTOMER",
        evidence: [reverified.metadata.doc_id],
        explanations,
        fact: `${reverified.metadata.doc_id} re-verified ${label4(customer.name)}'s identity on ${reverified.metadata.dated}, before the dormant account reactivated`
      } : { alert, code: closeCode(explanations), evidence: [], explanations });
      continue;
    }
    if (alert.rule_id === "TM02") {
      const suspicion = rapidMovementSuspicion(pack, open);
      if (suspicion) {
        suspicions.push({ ...suspicion, rank: rankOf(suspicion.code) });
        continue;
      }
    }
    if (alert.rule_id === "TM06") {
      const people = new Set(open.filter((tx) => !looksLikeOrganization(tx.counterparty_name) && !sameName(tx.counterparty_name, customer.name)).map((tx) => nameKey(tx.counterparty_name ?? "")));
      if (people.size >= 2) {
        const risky = largest2(open);
        const countries = String(record2(alert.measured).countries ?? (risky.counterparty_country ?? "a higher-risk country"));
        suspicions.push({
          code: "ESC_HIGH_RISK_CORRIDOR",
          rank: rankOf("ESC_HIGH_RISK_CORRIDOR"),
          evidence: open.map((tx) => tx.transaction_id),
          fact: `${alert.rule_id} flagged payments with ${people.size} unrelated individuals involving ${countries}, a higher-risk country ${label4(customer.name)} did not declare, including ${describe(risky)}, and nothing on file explains them`
        });
        continue;
      }
    }
    if (alert.rule_id === "TM08") {
      const payouts = open.filter((tx) => tx.direction === "out" && !sameName(tx.counterparty_name, customer.name));
      if (payouts.length) {
