function record2(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
}
var label = (s) => s.replace(/\s+/g, " ").trim();
var gbp = new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" });
var txText = (tx) => `${gbp.format(tx.amount_gbp)} ${tx.direction === "in" ? "from" : "to"} ${label(tx.counterparty_name ?? "an unidentified counterparty")} on ${tx.booked_at.slice(0, 10)} (${tx.transaction_id})`;
var sentence = (s) => `${label(s).replace(/[.!?]+$/, "")}.`;
var distinct = (ids2) => [...new Set(ids2)];
function finding(verdict, code, facts, action, evidence, request) {
  return { verdict, code, sentences: [sentence(facts), sentence(action)], evidence, request };
}
function anchor(txs, direction) {
  return txs.reduce((largest, tx) => (!direction || tx.direction === direction) && (!largest || tx.amount_gbp > largest.amount_gbp) ? tx : largest, void 0);
}
function profile(pack, alert) {
  const measured = record2(alert?.measured);
  const declared = record2(pack.customer.declared);
  const incoming = pack.windowTransactions.filter((t) => t.direction === "in");
  const annual = declared.annual_turnover_gbp;
  const income = declared.monthly_income_gbp;
  const baseline = typeof measured.baseline_gbp === "number" && measured.baseline_gbp > 0 ? measured.baseline_gbp : typeof income === "number" && income > 0 ? income : typeof annual === "number" && annual > 0 ? annual / 12 : void 0;
  const measuredReceived = measured.received_gbp;
  const total = typeof measuredReceived === "number" ? measuredReceived : incoming.reduce((sum, tx) => sum + (minor(tx.amount_gbp) ?? 0), 0) / 100;
  return { baseline, total, incoming };
}
var documentedCreditRules = /* @__PURE__ */ new Set(["TM01", "TM06", "TM07", "TM08"]);
function isDeclaredPayroll(pack, tx) {
  const employer = pack.customer.employer;
  const source = record2(pack.customer.declared).source_of_funds;
  return tx.direction === "in" && tx.channel === "bacs" && typeof source === "string" && normalize(source) === "salary" && typeof employer === "string" && !!employer.trim() && !!tx.counterparty_name && normalize(employer) === normalize(tx.counterparty_name) && typeof tx.reference === "string" && normalize(tx.reference) === `salary ${normalize(employer)}`;
}
function explainDocumentedCredit(pack, alert, txs, credits) {
  if (!documentedCreditRules.has(alert.rule_id)) return;
  const matches = txs.flatMap((tx) => credits.get(tx.transaction_id) ?? []);
  if (!matches.length) return;
  const unmatched = txs.filter((tx) => !credits.has(tx.transaction_id));
  if (alert.rule_id === "TM01") {
    const { total, baseline } = profile(pack, alert);
    const amounts = txs.map((tx) => minor(tx.amount_gbp));
    if (amounts.some((amount) => amount === void 0) || txs.some((tx) => tx.direction !== "in") || amounts.reduce((sum, amount) => sum + (amount ?? 0), 0) !== minor(total)) return;
    if (unmatched.length && (unmatched.length !== 1 || !baseline || unmatched[0].amount_gbp >= 3 * baseline || !isDeclaredPayroll(pack, unmatched[0]))) return;
  } else if (unmatched.length) {
    return;
  }
  const facts = matches.map((match) => match.original ? `${match.documentId} records ${match.reference} and links the refund of ${txText(match.payment)} to the original payment of ${txText(match.original)}` : `${match.documentId} records ${match.reference} for ${label(pack.customer.name)} and matches the insurer credit of ${txText(match.payment)}`);
  const code = matches.every((match) => match.kind === "refund") ? "REFUND_OF_EARLIER_PAYMENT" : "DOCUMENTED_EVENT";
  return finding(
    "CLOSE",
    code,
    facts.join("; "),
    unmatched.length ? `The remaining flagged inflow for ${alert.rule_id} is declared payroll of ${txText(unmatched[0])}` : `The documented ${matches.length === 1 ? "credit explains" : "credits explain"} all the activity flagged by ${alert.rule_id}`,
    [
      ...matches.flatMap((match) => [match.documentId, match.payment.transaction_id, ...match.original ? [match.original.transaction_id] : []]),
      ...unmatched.map((tx) => tx.transaction_id)
    ]
  );
}
var escalationByRule = {
  TM02: "ESC_PASS_THROUGH",
  TM06: "ESC_HIGH_RISK_CORRIDOR",
  TM10: "ESC_EARLY_REDEMPTION"
};
function decideCase(pack) {
  const { caseRecord, customer, alerts, documents, heldPayment } = pack;
  const all = new Map(pack.flaggedTransactions.map((tx) => [tx.transaction_id, tx]));
  if (heldPayment) all.set(heldPayment.transaction_id, heldPayment);
  const invoiceIds = matchedInvoices(pack, [...all.values()]);
  const credits = documentedCredits(pack);
  const ownership = new Map([...all.values()].map((tx) => [tx.transaction_id, ownedAccount(pack, tx)]));
  const global = [];
  const alertFindings = [];
  const { from } = caseRecord.review_window;
  const currentDocs = documents.filter((doc) => doc.metadata.dated >= from);
  const reports = currentDocs.filter(({ metadata }) => metadata.type === "sending_bank_fraud_report");
  const sample = anchor([...all.values()], "in") ?? anchor([...all.values()]);
  if (reports.length) {
    const subjects = reports.flatMap((doc) => {
      const subject = /^\*\*Subject:\*\*\s*(.+)$/im.exec(doc.markdown)?.[1];
      return subject ? [label(subject)] : [];
    });
    global.push(finding(
      "ESCALATE",
      "ESC_MULE_ACTIVITY",
      `Sending-bank fraud ${reports.length === 1 ? "report" : "reports"} ${reports.map((d) => d.metadata.doc_id).join(", ")} ${subjects.length ? `record ${distinct(subjects).join("; ")} for activity on` : "raise a fraud concern on"} ${label(customer.name)}'s account`,
      `Refer the account to the MLRO${sample ? ` and review the flagged flow including ${txText(sample)}` : " before any customer contact"}`,
      [...reports.map((d) => d.metadata.doc_id), ...sample ? [sample.transaction_id] : []]
    ));
  }
  for (const alert of alerts) {
    const txs = alert.transaction_ids.map((id) => all.get(id));
    const tx = alert.rule_id === "TM01" ? anchor(txs, "in") ?? anchor(txs) : anchor(txs);
    const evidence = tx ? [tx.transaction_id] : [];
    const trigger = tx ? `${alert.rule_id} flagged ${txText(tx)} in ${label(customer.name)}'s case` : `${alert.rule_id} flagged activity in ${label(customer.name)}'s ${caseRecord.review_window.from} to ${caseRecord.review_window.to} review`;
    const notes = currentDocs.filter((doc) => doc.metadata.type === "staff_note");
    if (alert.rule_id === "TM22") {
      const assessment = assessListMatch({ measured: alert.measured }, pack.internalList, documents, txs);
      const assessedTx = txs.find((t) => t.transaction_id === assessment.transactionId) ?? tx;
      const reliedOn2 = [...assessment.evidence, ...assessedTx ? [assessedTx.transaction_id] : []];
      if (assessment.status === "confirmed") {
        const subject = assessedTx ? txText(assessedTx) : alert.alert_id;
        alertFindings.push(finding(
          "ESCALATE",
          "ESC_LISTED_PARTY",
          assessment.detail,
          `Refer the internal-list match for ${subject} to the MLRO`,
          reliedOn2
        ));
      } else if (assessment.status === "different") {
        const invoices = txs.flatMap((t) => invoiceIds.get(t.transaction_id) ?? []);
        alertFindings.push(finding(
          "CLOSE",
          "LIST_MATCH_DIFFERENT_PARTY",
          assessment.detail,
          `${trigger}${invoices.length ? `, and ${distinct(invoices).join(", ")} reconciles the flagged payment evidence` : ""}`,
          [...reliedOn2, ...alert.transaction_ids, ...invoices]
        ));
      } else {
        alertFindings.push(finding(
          "RFI",
          "RFI_COUNTERPARTY_DETAILS",
          assessment.detail,
          `For ${assessedTx ? txText(assessedTx) : alert.alert_id}, ask for official identification of the matched counterparty or officer that distinguishes them from the listed party`,
          reliedOn2,
          `counterparty:${assessedTx?.transaction_id ?? alert.alert_id}`
        ));
      }
      continue;
    }
    if (alert.rule_id === "TM03") {
      const note = notes.find((d) => /\b(?:below|under)\b[^.\n]{0,130}\b(?:threshold|reporting|verification|exempt)|\b(?:avoid|evade|bypass)\b[^.\n]{0,100}\b(?:threshold|reporting|verification|checks|invoice)/i.test(d.markdown));
      if (note) {
        alertFindings.push(finding(
          "ESCALATE",
          "ESC_STRUCTURING",
          `${trigger}; staff note ${note.metadata.doc_id} records a discussion of staying below the applicable checks`,
          "Refer the repeated subthreshold activity to the MLRO rather than contacting the customer",
          [note.metadata.doc_id, ...alert.transaction_ids]
        ));
        continue;
      }
    }
    if (alert.rule_id === "TM06") {
      const note = notes.find((d) => /\b(?:unwilling|refused|declined)\s+to\s+(?:explain|clarify|disclose|identify|provide)/i.test(d.markdown));
      if (note) {
        alertFindings.push(finding(
          "ESCALATE",
          "ESC_HIGH_RISK_CORRIDOR",
          `${trigger}; staff note ${note.metadata.doc_id} records a refusal to explain or substantiate the activity`,
          "Pass the unexplained higher-risk activity to the MLRO",
          [note.metadata.doc_id, ...evidence]
        ));
        continue;
      }
    }
    const documented = explainDocumentedCredit(pack, alert, txs, credits);
    if (documented) {
      alertFindings.push(documented);
      continue;
    }
    const own = txs.flatMap((t) => ownership.get(t.transaction_id) ?? []);
    const invoice = txs.flatMap((t) => invoiceIds.get(t.transaction_id) ?? []);
    if (txs.length && own.length === txs.length && ["TM01", "TM02", "TM06", "TM08"].includes(alert.rule_id)) {
      const p = profile(pack, alert.rule_id === "TM01" ? alert : void 0);
      const tied = [...distinct(own), ...alert.transaction_ids];
      if (!p.baseline || Number(p.total.toFixed(2)) >= Number((5 * p.baseline).toFixed(2))) {
        const ratio = p.baseline ? `${gbp.format(p.total)} against a declared monthly baseline of ${gbp.format(p.baseline)}` : "no usable declared monthly amount for comparison";
        alertFindings.push(finding(
          "RFI",
          "RFI_UPDATED_PROFILE",
          `${distinct(own).join(", ")} documents the other account ownership for ${tx ? txText(tx) : alert.alert_id}, with ${ratio}`,
          `Ask ${label(customer.name)} for their updated expected monthly income or payment volume`,
          tied,
          "profile"
        ));
      } else {
        alertFindings.push(finding(
          "CLOSE",
          "OWN_ACCOUNT",
          `${distinct(own).join(", ")} identifies the other accounts as held by ${label(customer.name)} and supports the flagged transfers`,
          `${trigger}; reviewed inflows of ${gbp.format(p.total)} are below five times the ${gbp.format(p.baseline)} monthly baseline`,
          tied
        ));
      }
      continue;
    }
    if (txs.length && invoice.length === txs.length && ["TM04", "TM06"].includes(alert.rule_id)) {
      alertFindings.push(finding(
        "CLOSE",
        "INVOICE_MATCHES",
        `${distinct(invoice).join(", ")} reconciles the billed customer, payee, date and amount for the flagged payments`,
        `${trigger}; the invoices explain the flagged outgoing activity`,
        [...distinct(invoice), ...alert.transaction_ids]
      ));
      continue;
    }
    if (alert.rule_id === "TM02" && txs.some((t) => t.direction === "in") && txs.some((t) => t.direction === "out") && new Set(txs.filter((t) => !ownership.get(t.transaction_id)).map((t) => normalize(t.counterparty_name ?? ""))).size > 1) {
      const incoming = anchor(txs, "in");
      const outgoing = anchor(txs, "out");
      alertFindings.push(finding(
        "ESCALATE",
        "ESC_PASS_THROUGH",
        `The rapid-movement alert links ${txText(incoming)} and ${txText(outgoing)}`,
        "The available reconciliations do not explain the flows between the parties; refer the linked movements to the MLRO",
        [incoming.transaction_id, outgoing.transaction_id]
      ));
      continue;
    }
    const subjectTx = alert.rule_id === "TM01" || alert.rule_id === "TM05" ? tx : heldPayment ?? tx;
    const description = subjectTx ? txText(subjectTx) : `alert ${alert.alert_id}`;
    const requestEvidence = subjectTx ? [subjectTx.transaction_id, ...evidence] : evidence;
    if (alert.rule_id === "TM03" && caseRecord.institution !== "payments_fx") {
      alertFindings.push(finding(
        "RFI",
        "RFI_BUSINESS_RECORDS",
        `${trigger}; the repeated cash activity has not been reconciled to the underlying receipts`,
        `Ask for the cash receipts ledger covering the flagged deposits or top-ups in the ${caseRecord.review_window.from} to ${caseRecord.review_window.to} window`,
        alert.transaction_ids,
        "cash-ledger"
      ));
    } else if (alert.rule_id === "TM01" || alert.rule_id === "TM05") {
      const p = profile(pack, alert.rule_id === "TM01" ? alert : void 0);
      const appendix = alert.rule_id === "TM01" && p.baseline ? `; the review records ${gbp.format(p.total)} against a ${gbp.format(p.baseline)} monthly baseline` : "";
      const inflows = txs.filter((t) => t.direction === "in");
      const scope = alert.rule_id === "TM01" && inflows.length > 1 ? `${description} and the other flagged inflows in the review window` : description;
      alertFindings.push(finding(
        "RFI",
        "RFI_SOURCE_OF_FUNDS",
        trigger + appendix,
        `Ask for the source-of-funds record showing how the money for ${scope} was obtained`,
        requestEvidence,
        `source:${subjectTx?.transaction_id ?? alert.alert_id}`
      ));
    } else if (alert.rule_id === "TM08") {
      alertFindings.push(finding(
        "RFI",
        "RFI_COUNTERPARTY_DETAILS",
        `${trigger}; the other account's ownership or relationship to the customer is not established`,
        `Ask for the originating or receiving account statement naming its holder for ${description}`,
        requestEvidence,
        `counterparty:${subjectTx?.transaction_id ?? alert.alert_id}`
      ));
    } else {
      const purpose = alert.rule_id === "TM07" ? "the instruction documenting why the dormant account was reactivated for" : alert.rule_id === "TM10" ? "the redemption instruction documenting the purpose of" : "the underlying invoice or signed payment instruction showing the purpose of";
      alertFindings.push(finding(
        "RFI",
        "RFI_PURPOSE_DOCUMENTS",
        `${trigger}; the records do not substantiate the purpose of the flagged activity`,
        `Ask for ${purpose} ${description}`,
        requestEvidence,
        `purpose:${subjectTx?.transaction_id ?? alert.alert_id}`
      ));
    }
  }
  if (caseRecord.institution === "payments_fx" && heldPayment && heldPayment.amount_gbp >= 1e4 && !ownership.get(heldPayment.transaction_id) && !invoiceIds.has(heldPayment.transaction_id)) {
    const hasBill = documents.some((doc) => doc.extraction.kind === "invoice" || /contract/.test(doc.metadata.type));
    if (!hasBill) {
      global.push(finding(
        "RFI",
        "RFI_PURPOSE_DOCUMENTS",
        `The held payment of ${txText(heldPayment)} requires an invoice or contract before release`,
        "Ask for the invoice or signed contract naming the beneficiary and tying the amount to this held payment",
        [heldPayment.transaction_id],
        `purpose:${heldPayment.transaction_id}`
      ));
    } else {
      global.push(finding(
        "RFI",
        "RFI_PURPOSE_DOCUMENTS",
        `No invoice or contract has been reconciled to the held payment of ${txText(heldPayment)}`,
        "Ask for the invoice or signed contract that identifies this beneficiary and supports the exact held amount",
        [heldPayment.transaction_id],
        `purpose:${heldPayment.transaction_id}`
      ));
    }
  }
  const decisions = [...global, ...alertFindings];
  const suspicion = decisions.find((f) => f.verdict === "ESCALATE");
  const gaps = decisions.filter((f) => f.verdict === "RFI");
  let primary;
  let reliedOn;
  let extra = "";
  if (suspicion) {
    primary = suspicion;
    reliedOn = [primary];
  } else if (gaps.length && new Set(gaps.map((f) => f.request)).size === 1) {
    primary = gaps[0];
    reliedOn = decisions;
  } else if (gaps.length || !decisions.length) {
    const relevant = alerts.find((a) => a.rule_id === "TM02") ?? alerts.find((a) => a.rule_id === "TM06") ?? alerts[0];
    const codes = relevant ? escalationByRule[relevant.rule_id] : void 0;
    const context = sample ? `, including ${txText(sample)}` : "";
    primary = finding(
      "ESCALATE",
      codes ?? "ESC_UNEXPLAINED_FUNDS",
      `The review of ${label(customer.name)} leaves ${gaps.length || "unassessed"} material evidence gaps${context}`,
      "No single request would settle the outstanding activity, so refer the case to the MLRO rather than close it",
      sample ? [sample.transaction_id] : []
    );
    reliedOn = [primary, ...gaps];
  } else {
    primary = decisions.find((f) => f.code === "LIST_MATCH_DIFFERENT_PARTY") ?? decisions[0];
    reliedOn = decisions;
  }
  if (primary.verdict !== "ESCALATE" && reliedOn.length > 1) {
    const other = reliedOn.find((f) => f !== primary && f.verdict === "CLOSE" && f.sentences[0] !== primary.sentences[0]);
    if (other) extra = ` ${other.sentences[0]}`;
    else if (primary.verdict === "CLOSE" && (primary.code === "DOCUMENTED_EVENT" || primary.code === "REFUND_OF_EARLIER_PAYMENT")) {
      extra = ` ${sentence(`The reconciled evidence covers ${distinct(alerts.map((alert) => alert.rule_id)).join(" and ")}`)}`;
    }
  }
  return {
    case_id: caseRecord.case_id,
    alert_ids: caseRecord.alert_ids,
    verdict: primary.verdict,
    reason_code: primary.code,
    reason: primary.sentences.join(" ") + extra,
    evidence: distinct(reliedOn.flatMap((f) => f.evidence))
  };
}

// src/submission.ts
function verify(pack, result) {
  const { case_id, alert_ids } = pack.caseRecord;
  if (result.case_id !== case_id || result.alert_ids.length !== alert_ids.length || alert_ids.some((id, i) => result.alert_ids[i] !== id)) {
    throw new Error(`${case_id}: incorrect case or alert coverage`);
  }
  const allowedCodes = reasonCodes[result.verdict];
  if (!allowedCodes?.includes(result.reason_code) || !result.reason.trim()) {
    throw new Error(`${case_id}: invalid verdict, reason code, or explanation`);
  }
  const validEvidence = /* @__PURE__ */ new Set([
    ...pack.flaggedTransactions.map((row) => row.transaction_id),
    ...pack.windowTransactions.map((row) => row.transaction_id),
    ...pack.priorTransactions.map((row) => row.transaction_id),
    ...pack.heldPayment ? [pack.heldPayment.transaction_id] : [],
    ...pack.documents.map((doc) => doc.metadata.doc_id),
    ...pack.internalList.map((row) => row.entry_id)
  ]);
  if (new Set(result.evidence).size !== result.evidence.length || result.evidence.some((id) => !validEvidence.has(id))) {
    throw new Error(`${case_id}: invalid evidence reference`);
  }
}
function runSubmission(input, output) {
  const target = resolve2(output);
  const canonical = join2(realpathSync3(dirname(target)), basename(target));
  const inputRoot = realpathSync3(input);
  const sub = relative3(inputRoot, canonical);
  if (!sub || sub !== ".." && !sub.startsWith(`..${sep3}`) && !isAbsolute3(sub)) {
    throw new Error("Output must not overwrite or be placed inside the supplied institution directory");
  }
  const existing = lstatSync(canonical, { throwIfNoEntry: false });
  if (existing && (!existing.isFile() || existing.nlink > 1)) {
    throw new Error("Output path must be a regular, unshared file");
  }
  const reader = loadInstitutionCases(inputRoot);
  const lines = [];
  for (const id of reader.caseIds) {
    const pack = reader.get(id);
    const result = decideCase(pack);
    verify(pack, result);
    lines.push(JSON.stringify(result));
  }
  writeFileSync(canonical, lines.length ? `${lines.join("\n")}
` : "", "utf8");
}

// src/index.ts
var arguments_ = process.argv.slice(2);
if (arguments_.length === 1 && ["--help", "-h"].includes(arguments_[0])) {
  console.log("Usage: system/run <institution-folder> <output-file>");
} else if (arguments_.length !== 2 || arguments_.some((arg) => !arg.trim())) {
  console.error("Usage: system/run <institution-folder> <output-file>");
  process.exitCode = 2;
} else {
  try {
    runSubmission(arguments_[0], arguments_[1]);
  } catch (error) {
    console.error(`run: ${error instanceof Error ? error.message : String(error)}`);
    process.exitCode = 1;
  }
}
