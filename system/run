function cancellations(ctx, add) {
  for (const doc of ofType(ctx, "cancellation_confirmation")) {
    const md = doc.markdown;
    const amount = onlyPounds(md);
    const received = isoDay(/\breceived(?: on)? (\d{1,2} [A-Za-z]+ \d{4})/i.exec(md)?.[1]);
    const accounts = [...new Set([...md.matchAll(/\b(\d{2}-\d{2}-\d{2} \d{8})\b/g)].map((m) => m[1]))];
    const account = accounts.length === 1 ? accounts[0] : void 0;
    if (!/\bcancel/i.test(md) || !account || amount === void 0 || !received) continue;
    const paidIn = incoming(ctx).find((tx) => samePence(tx, amount) && txDay(tx) === received && sameAccount(tx.counterparty_account, account) && sameName(tx.counterparty_name, ctx.name));
    const refund = outgoing(ctx).find((tx) => samePence(tx, amount) && txDay(tx) >= received && sameAccount(tx.counterparty_account, account));
    if (!paidIn || !refund) continue;
    const fact = `${doc.metadata.doc_id} confirms the cancelled subscription of ${describe(paidIn)} was returned to the same account in ${label(ctx.name)}'s name as ${describe(refund)}`;
    for (const tx of [paidIn, refund]) add(tx, { code: "REFUND_OF_EARLIER_PAYMENT", docs: [doc.metadata.doc_id], related: [paidIn.transaction_id, refund.transaction_id], fact });
  }
}
function redundancy(ctx, add) {
  const employer = typeof ctx.pack.customer.employer === "string" ? ctx.pack.customer.employer : void 0;
  const letters = ofType(ctx, "redundancy_letter").filter((doc) => /redundan/i.test(doc.markdown) && !!employer && sameName(fromTitle(doc, /^Letter from (.+)$/i), employer));
  if (!letters.length) return;
  const emails = ofType(ctx, "customer_email").filter((doc) => /redundan/i.test(doc.markdown) && /\bsell\b/i.test(doc.markdown));
  for (const alert of ctx.pack.alerts.filter((a) => a.rule_id === "TM10")) {
    const moves = ctx.subjects.filter((tx) => alert.transaction_ids.includes(tx.transaction_id));
    const buys = moves.filter((tx) => tx.channel === "fund_subscription" && tx.direction === "out");
    const sales = moves.filter((tx) => tx.channel === "fund_redemption" && tx.direction === "in");
    if (buys.length !== 1 || sales.length !== 1) continue;
    const [buy] = buys;
    const [sale] = sales;
    if (!buy?.counterparty_name || !sale?.counterparty_name || !sameName(buy.counterparty_name, sale.counterparty_name)) continue;
    const letter = letters.find((doc) => txDay(buy) <= dated(doc) && dated(doc) <= txDay(sale) && emails.some((email2) => dated(doc) <= dated(email2) && dated(email2) <= txDay(sale)));
    if (!letter) continue;
    const email = emails.find((doc) => dated(letter) <= dated(doc) && dated(doc) <= txDay(sale));
    if (!email) continue;
    for (const tx of [buy, sale]) add(tx, {
      code: "DOCUMENTED_EVENT",
      docs: [letter.metadata.doc_id, email.metadata.doc_id],
      related: [],
      fact: `${letter.metadata.doc_id} from ${employer} records redundancy before the fund sale; ${email.metadata.doc_id} links that redundancy to the request to sell (${describe(tx)})`
    });
  }
}
function cashRedeposits(ctx, add) {
  for (const chat of ofType(ctx, "support_chat")) {
    const claim = /(£[\d,]+\.\d{2}) I withdrew (?:back )?in ([A-Za-z]+ \d{4})/.exec(chat.markdown);
    const amount = pounds(claim?.[1]);
    const month = isoMonth(claim?.[2]);
    if (amount === void 0 || !month) continue;
    const withdrawals = ctx.history.filter((tx) => tx.direction === "out" && tx.channel === "cash_withdrawal" && samePence(tx, amount) && txDay(tx).startsWith(month));
    if (withdrawals.length !== 1) continue;
    const reviewed = ctx.pack.previousReviews.some((review) => review.rule_id === "TM05" && /^closed\b/i.test(review.note) && /cash withdrawal/i.test(review.note) && typeof review.reviewed_on === "string" && review.reviewed_on >= txDay(withdrawals[0]));
    if (!reviewed) continue;
    for (const tx of incoming(ctx)) {
      if (isCash(tx) && samePence(tx, amount) && txDay(tx) > txDay(withdrawals[0]) && dated(chat) >= txDay(tx)) {
        add(tx, {
          code: "WITHIN_PROFILE",
          docs: [chat.metadata.doc_id],
          related: [withdrawals[0].transaction_id],
          fact: `${chat.metadata.doc_id} records ${label(ctx.name)} re-depositing the same cash withdrawn as ${describe(withdrawals[0])} for a private car purchase that a prior review closed, matching ${describe(tx)}`
        });
      }
    }
  }
}
